// Typed service fixtures test units, stale clearing, bounded refresh and target IDs.
Model :: #import "model";
mode: s32;
terminated: s32;
stamp: s64 = 1000000000;
counter: s64 = 100000000;
identity: s64 = 1;
#program_export
SampleNanos :: () -> s64 { return stamp }
#program_export
Capture :: () -> s32 {
    if mode == 1 { return -1 }
    if mode == 6 { return 0 }
    if mode == 7 { return Model.MAX_PROCESSES }
    return 2
}
#program_export
TaskAt :: (index: s32, fields: []s64, name: []u8, user: []u8) -> s32 {
    if mode == 2 && index == 1 { return -1 }
    fields[0] = 100 + index
    fields[1] = 7
    fields[2] = 4
    fields[3] = ifx index == 0 then 12 else -1
    fields[4] = ifx index == 0 then counter else 0
    fields[5] = identity + cast(s64)index
    fields[6] = 0
    if mode == 8 { fields[4] = -1 }
    if mode == 9 { fields[0] = 200 + index }
    name[0] = cast(u8)(65 + index % 26)
    if mode == 5 { name[0] = 90 }
    name[1] = 0
    user[0] = 0
    return 0
}
#program_export
PoolAt :: (index: s32, fields: []s64) -> s32 {
    if mode == 3 { return -1 }
    fields[0] = ifx mode == 4 then 8192 else 4096
    fields[1] = 33554432
    fields[2] = 8192
    return 0
}
#program_export
Terminate :: (pid: s32) -> s32 { terminated = pid; return 0 }
#program_export
main :: () -> s32 {
    max_bytes: [14]u8
    full_bytes: [32]u8
    maximum := cast(u64)18446744073709551615
    if Model.FormatBytes(maximum, max_bytes[:]) != Model.FormatBytes(maximum, full_bytes[:]) { return 12 }
    Model.Refresh()
    initial_revision := Model.TableRevision()
    for sample: 0..999 {
        Model.Refresh()
        snapshot := Model.Current()
        if !snapshot.processes_available || snapshot.count != 2 { return 1 }
        if snapshot.cpu_available || !snapshot.memory_available { return 2 }
        if snapshot.memory_used != 4096 || snapshot.memory_total != 33554432 { return 3 }
        if snapshot.processes[0].pid != 100 || snapshot.processes[0].memory_bytes != 12288 { return 4 }
        if snapshot.processes[1].memory_available { return 5 }
    }
    if Model.TableRevision() != initial_revision { return 13 }
    mode = 4
    Model.Refresh()
    if Model.TableRevision() != initial_revision || Model.Current().memory_used != 8192 { return 14 }
    mode = 5
    Model.Refresh()
    if Model.TableRevision() == initial_revision { return 15 }
    mode = 0
    Model.Refresh()
    if !Model.EndTask(101) || terminated != 101 { return 6 }
    if Model.EndTask(0) || terminated != 101 { return 7 }
    if Model.StartTask("host command must not execute") { return 8 }
    mode = 1
    Model.Refresh()
    if Model.Current().processes_available || Model.Current().count != 0 { return 9 }
    mode = 2
    Model.Refresh()
    if Model.Current().processes_available || Model.Current().count != 0 { return 10 }
    mode = 3
    Model.Refresh()
    if Model.Current().memory_available || Model.Current().memory_used != 0 { return 11 }
    mode = 6
    Model.Refresh()
    if !Model.Current().processes_available || Model.Current().count != 0 { return 16 }
    mode = 7
    Model.Refresh()
    if Model.Current().count != 1024 || Model.Current().processes[1023].pid != 1123 { return 17 }
    // Start a new task pair; first reading is unavailable, then a real delta.
    mode = 9
    stamp = 2000000000
    Model.Refresh()
    if Model.Current().processes[0].cpu_available { return 18 }
    stamp += 1000000000
    counter += 250000000
    Model.Refresh()
    snapshot := Model.Current()
    if !snapshot.cpu_available || snapshot.cpu_measured_tasks != 2 ||
       !snapshot.processes[0].cpu_available || snapshot.processes[0].cpu_percent != 25.0 ||
       snapshot.processes[1].cpu_percent != 0 || snapshot.cpu_percent != 25.0 { return 19 }
    order: [2]s32
    Model.SortOrder(snapshot, order[:], Model.COLUMN_CPU, -1)
    if order[0] != 0 { return 20 }
    // Same clock, changed identity and counter rollback never carry a delta.
    Model.Refresh()
    if Model.Current().cpu_available { return 21 }
    stamp += 1000000000
    identity = 20
    Model.Refresh()
    if Model.Current().cpu_available { return 22 }
    stamp += 1000000000
    counter = 0
    Model.Refresh()
    if Model.Current().processes[0].cpu_available { return 23 }
    stamp += 1000000000
    Model.Refresh()
    if !Model.Current().processes[0].cpu_available || Model.Current().processes[0].cpu_percent != 0 { return 24 }
    mode = 8
    stamp += 1000000000
    Model.Refresh()
    if Model.Current().cpu_available { return 25 }
    mode = 1
    Model.Refresh()
    if Model.Current().cpu_available { return 26 }
    mode = 9
    stamp += 1000000000
    Model.Refresh()
    if Model.Current().cpu_available { return 27 }
    // More than one core of measured task CPU must not be clamped in totals.
    total_text: [24]u8
    if Model.FormatAccountedCpu(125.5, total_text[:]) != "125.5" { return 28 }
    print("taskmgr Taiji adapter tests passed\n")
    return 0
}
