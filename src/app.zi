// taskmgr: a Kryon task manager for Linux with the classic layout: a menu
// bar, Applications / Processes / Performance tabs and a status bar. Frame
// runs every frame and declares the whole interface from the model's current
// /proc snapshot and the window manager's task list. Colors come from the
// active Kryon theme after installing the desktop's GTK palette at startup.
//
//   kryon run          the desktop window
//   kryon run shot     one rendered frame without a display
//
// TASKMGR_TAB=applications|processes|performance picks the starting tab.

#if !#defined(TASKMGR_TAIJI) {
libc :: #system_library "libc";
// SystemThemeHostLinux reads the supervising X11 container palette. Keep its
// native library on the final application link as well as inside the module.
theme_x11 :: #system_library "X11";
Environment :: (name: *u8) -> *u8 #foreign libc "getenv";
ThemeXInitThreads :: () -> s32 #foreign theme_x11 "XInitThreads";

}

TAB_APPLICATIONS :: 0;
TAB_PROCESSES :: 1;
TAB_PERFORMANCE :: 2;

MENU_NEW_TASK :: 10;
MENU_EXIT :: 11;
MENU_CONFIRM_END :: 12;
MENU_GROUP_PROCESSES :: 13;
MENU_REFRESH :: 20;
MENU_SPEED_HIGH :: 21;
MENU_SPEED_NORMAL :: 22;
MENU_SPEED_LOW :: 23;
MENU_SPEED_PAUSED :: 24;
MENU_KERNEL_TIMES :: 25;
MENU_ABOUT :: 30;

DIALOG_NONE :: 0;
DIALOG_RUN :: 1;
DIALOG_ABOUT :: 2;
DIALOG_END_PROCESS :: 3;

// Update speeds in milliseconds; zero pauses automatic updates.
SPEED_HIGH_MS :: 500;
SPEED_NORMAL_MS :: 1000;
SPEED_LOW_MS :: 4000;
REFRESH_FALLBACK_FRAMES :: 60;

MENU_HEIGHT :: 30.0;
TAB_HEIGHT :: 34.0;
STATUS_HEIGHT :: 26.0;
BUTTON_HEIGHT :: 32.0;
BUTTON_WIDTH :: 120.0;
PAD :: 10.0;

COLUMNS :: Model.COLUMNS;
APP_COLUMNS :: 5;
APP_COLUMN_CPU :: 2;
APP_COLUMN_MEMORY :: 3;
APP_COLUMN_GPU :: 4;
// Ten-digit PIDs, percentages, elapsed times and adaptive byte values fit in
// 16 bytes; process/group names use the model's bounded 32-byte capacity.
CELL_WIDTH :: 16;
// Column bounds: signed 32-bit PID, normalized whole CPU %, adaptive u64 bytes.
PID_CELL_WIDTH :: 11;
CPU_CELL_WIDTH :: 4;
MEMORY_CELL_WIDTH :: 14;
NAME_WIDTH :: Model.NAME_CAPACITY;
STATUS_WIDTH :: 160;
// A flattened grouped table contains every raw process plus at most one header
// per two members: singleton groups use their raw row directly.
#if #defined(TASKMGR_TAIJI) {
MAX_DISPLAY_ROWS :: Model.MAX_PROCESSES;
} else {
MAX_DISPLAY_ROWS :: Model.MAX_PROCESSES + Model.MAX_PROCESSES / 2;
}

process_columns: [5]string = .{"Image Name", "PID", "CPU", "CPU Time", "Memory"};
process_fractions: [5]float32 = .{0.40, 0.12, 0.10, 0.16, 0.22};
process_widths: [COLUMNS]s32;
app_columns: [5]string = .{"Task", "Status", "CPU", "Memory", "GPU"};
app_fractions: [5]float32 = .{0.40, 0.20, 0.11, 0.17, 0.12};
app_widths: [APP_COLUMNS]s32;
widths_for: float32;
widths_gpu: bool;
// Set when a window was expanded or collapsed; Frame rebuilds the rows.
apps_layout_changed: bool;

group_order: [Model.MAX_PROCESSES]s32;
raw_order: [Model.MAX_PROCESSES]s32;

DisplayRow :: struct {
    process_index: s32
    group_index: s32
    group_header: bool
}

display_rows: [MAX_DISPLAY_ROWS]DisplayRow;
display_count: s32;

ExpandedGroup :: struct {
    name_count: s32
    name: [Model.NAME_CAPACITY]u8
}

expanded_groups: [Model.MAX_PROCESSES]ExpandedGroup;
expanded_count: s32;

// Table cell text in two generations, swapped each rebuild, so the previous
// frame's row views never alias the storage being rewritten. The generations
// are separate globals so the borrow checker sees disjoint backing storage.
CellText :: struct {
    cell: [MAX_DISPLAY_ROWS * COLUMNS]string
    name: [MAX_DISPLAY_ROWS * NAME_WIDTH]u8
    pid: [MAX_DISPLAY_ROWS * PID_CELL_WIDTH]u8
    cpu: [MAX_DISPLAY_ROWS * CPU_CELL_WIDTH]u8
#if !#defined(TASKMGR_TAIJI) {
    time: [MAX_DISPLAY_ROWS * CELL_WIDTH]u8
}
    mem: [MAX_DISPLAY_ROWS * MEMORY_CELL_WIDTH]u8
}

text_stores_a: CellText;
text_stores_b: CellText;
text_active: s32;
last_table_revision: u64;

// Window manager task lists, also in two generations. A window row totals its
// process tree (see Model.AppUsages); an expanded window lists those
// processes under it. process is -1 on a window row.
#if !#defined(TASKMGR_TAIJI) {
APP_ROWS :: Apps.MAX_WINDOWS + Model.MAX_PROCESSES;
TASK_WIDTH :: Apps.TITLE_CAPACITY + 8;
PROCESS_TASK_WIDTH :: NAME_WIDTH + 20;

AppRow :: struct {
    window: s32
    process: s32
}

AppText :: struct {
    list: Apps.AppList
    rows: [APP_ROWS]AppRow
    row_count: s32
    cell: [APP_ROWS * APP_COLUMNS]string
    task: [Apps.MAX_WINDOWS * TASK_WIDTH]u8
    process_task: [Model.MAX_PROCESSES * PROCESS_TASK_WIDTH]u8
    cpu: [APP_ROWS * CPU_CELL_WIDTH]u8
    mem: [APP_ROWS * MEMORY_CELL_WIDTH]u8
    gpu: [APP_ROWS * CPU_CELL_WIDTH]u8
}

app_pids: [Apps.MAX_WINDOWS]s32;
app_usage: [Apps.MAX_WINDOWS]Model.AppUsage;
tree_pids: [Model.MAX_PROCESSES]s32;
// NVML and DRM per-process GPU shares, merged for the current refresh.
gpu_pids: [2 * Gpu.MAX_GPU_PROCESSES]s32;
gpu_percent: [2 * Gpu.MAX_GPU_PROCESSES]float64;
gpu_count: s32;
// The GPU column appears only once a per-process source has data.
app_gpu_shown: bool;
expanded_windows: [Apps.MAX_WINDOWS]u64;
expanded_window_count: s32;

app_stores_a: AppText;
app_stores_b: AppText;
app_active: s32;
} else {
app_gpu_shown: bool;
}
no_external_gpus: [1]Model.GpuExternal;

current_tab: s32 = TAB_PROCESSES;
started: bool;
menu_state: Menu.MenuState;

sort_column: s32 = Model.COLUMN_CPU;
sort_direction: s32 = -1;
selected_row: s32 = -1;
selected_pid: s32 = -1;
selected_is_group: bool;
selected_group_name: [Model.NAME_CAPACITY]u8;
selected_group_name_count: s32;
selected_column: s32 = -1;
scroll_offset: s32 = 0;

app_selected_row: s32 = -1;
app_selected_window: u64;
// The process under the selected window, or -1 when the window row is.
app_selected_pid: s32 = -1;
app_scroll_offset: s32 = 0;

refresh_interval_ms: s64 = SPEED_NORMAL_MS;
frames_since_refresh: s32;
last_refresh_ms: s64 = -1;
pending_sort: bool;
refresh_requested: bool;
show_kernel_times: bool;
confirm_end: bool = true;
group_processes: bool = true;

dialog: s32 = DIALOG_NONE;
end_pid: s32 = -1;
end_is_group: bool;
end_group_name: [Model.NAME_CAPACITY]u8;
end_group_name_count: s32;
end_group_members: s32;
command_bytes: [Model.COMMAND_CAPACITY]u8;
command_next: [Model.COMMAND_CAPACITY]u8;
command_length: s32;
command_pending: bool;
command_cursor: s32;
command_anchor: s32;
command_scroll: s32;
typed: [64]u8;

// The status message is stored as raw bytes; no global retains a string view
// into it, so it can be rewritten between frames. The interface builds its
// display strings into frame locals every frame.
status_bytes: [STATUS_WIDTH]u8;
status_length: s32;
palette_background: u32;
palette_base: u32;
palette_text: u32;
palette_border: u32;

PaletteLayer :: (opacity: u32) -> u32 {
    return Theme.StateLayer(palette_background, palette_text, opacity)
}

AppendText :: (output: []u8, start: s32, text: string) -> s32 {
    length := start
    for byte: text {
        if length >= cast(s32)output.count { break }
        output[length] = byte
        length += 1
    }
    return length
}

Inset :: (bounds: Rectangle, amount: float32) -> Rectangle {
    width := bounds.width - amount * 2.0
    height := bounds.height - amount * 2.0
    if width < 0.0 { width = 0.0 }
    if height < 0.0 { height = 0.0 }
    return .{bounds.x + amount, bounds.y + amount, width, height}
}

TaskButton :: (session: Session, id: s32, label: string, bounds: Rectangle,
    accent: bool, disabled: bool) -> bool {
    props: Button.Props
    props.key = cast(u64)id
    props.id = id
    props.bounds = bounds
    props.label = label
    props.disabled = disabled
    // Outlined neutral buttons read as the classic bordered push buttons.
    props.emphasis = ButtonEmphasis.ButtonEmphasisOutline
    if accent {
        props.tone = ButtonTone.ButtonToneAccent
        props.emphasis = ButtonEmphasis.ButtonEmphasisFilled
    }
    return Button.Draw(session, props) == 1
}

ValueLabel :: (session: Session, key: s32, text: string, bounds: Rectangle, font: s32) {
    Text.Draw(session, Text.Props.{.key = cast(u64)key, .bounds = bounds, .text = text, .size = font,
        .align = TextAlign.TextAlignEnd})
}

CenteredLabel :: (session: Session, key: s32, text: string, bounds: Rectangle, font: s32) {
    Text.Draw(session, Text.Props.{.key = cast(u64)key, .bounds = bounds, .text = text, .size = font,
        .align = TextAlign.TextAlignCenter})
}

// Picks the starting tab from TASKMGR_TAB, matching its first letter.
StartingTab :: () -> s32 {
#if #defined(TASKMGR_TAIJI) {
    return TAB_PROCESSES
} else {

    variable := "TASKMGR_TAB"
    name: [16]u8
    length: s32 = 0
    for byte: variable {
        name[length] = byte
        length += 1
    }
    name[length] = 0
    value := Environment(*name[0])
    if value == null { return TAB_PROCESSES }
    first := value[0]
    if first == 97 || first == 65 { return TAB_APPLICATIONS }
    if first == 112 && value[1] == 101 { return TAB_PERFORMANCE }
    if first == 80 && value[1] == 101 { return TAB_PERFORMANCE }
    return TAB_PROCESSES

}
}

// Group names are retained as bytes, never as string views into refreshed
// snapshots. The model's matcher keeps Codex-family aliases in one group.
GroupNameMatches :: (name: []u8, entry: *Model.Process) -> bool {
    probe: Model.Process
    count := cast(s32)name.count
    if count > Model.NAME_CAPACITY { count = Model.NAME_CAPACITY }
    probe.name_count = count
    if count > 0 {
        for index: 0..count - 1 { probe.name[index] = name[index] }
    }
    return Model.SameProcessGroup(*probe, entry)
}

CopyGroupName :: (entry: *Model.Process, output: []u8) -> s32 {
    count := entry.name_count
    if count > cast(s32)output.count { count = cast(s32)output.count }
    if count > 0 {
        for index: 0..count - 1 { output[index] = entry.name[index] }
    }
    return count
}

GroupExpanded :: (entry: *Model.Process) -> bool {
    if expanded_count > 0 {
        for index: 0..expanded_count - 1 {
            saved := *expanded_groups[index]
            if GroupNameMatches(saved.name[0:saved.name_count], entry) { return true }
        }
    }
    return false
}

ToggleGroup :: (entry: *Model.Process) {
    if expanded_count > 0 {
        for index: 0..expanded_count - 1 {
            saved := *expanded_groups[index]
            if GroupNameMatches(saved.name[0:saved.name_count], entry) {
                expanded_count -= 1
                if index != expanded_count { expanded_groups[index] = expanded_groups[expanded_count] }
                return
            }
        }
    }
    if expanded_count >= Model.MAX_PROCESSES { return }
    expanded_groups[expanded_count].name_count =
        CopyGroupName(entry, expanded_groups[expanded_count].name[:])
    expanded_count += 1
}

AppendDisplayRow :: (process_index: s32, group_index: s32, group_header: bool) {
    if display_count >= MAX_DISPLAY_ROWS { return }
    display_rows[display_count].process_index = process_index
    display_rows[display_count].group_index = group_index
    display_rows[display_count].group_header = group_header
    display_count += 1
}

// Builds a flat table: aggregate group headers in the requested sort order,
// followed by the group's real processes while that header is expanded.
BuildDisplayRows :: () {
    raw := Model.Current()
    grouped := Model.GroupedCurrent()
    display_count = 0
    Model.SortOrder(raw, raw_order[:], sort_column, sort_direction)
    if !group_processes {
        if raw.count > 0 {
            for index: 0..raw.count - 1 { AppendDisplayRow(raw_order[index], -1, false) }
        }
        return
    }
    Model.SortGroupOrder(raw, grouped, group_order[:], sort_column, sort_direction)
    if grouped.count <= 0 { return }
    for position: 0..grouped.count - 1 {
        group_index := group_order[position]
        group := Model.GroupProcess(raw, *grouped.groups[group_index])
        if group.group_count <= 1 {
            process_index := Model.FindProcess(raw, group.pid)
            if process_index >= 0 { AppendDisplayRow(process_index, -1, false) }
            continue
        }
        AppendDisplayRow(-1, group_index, true)
        if GroupExpanded(*group) && raw.count > 0 {
            for raw_position: 0..raw.count - 1 {
                process_index := raw_order[raw_position]
                entry := *raw.processes[process_index]
                if Model.SameProcessGroup(*group, entry) {
                    AppendDisplayRow(process_index, group_index, false)
                }
            }
        }
    }
}

RebuildOrder :: (store: *CellText) {
    raw := Model.Current()
    grouped := Model.GroupedCurrent()
    BuildDisplayRows()
    selected_row = -1
    if display_count <= 0 { return }
    for index: 0..display_count - 1 {
        row := display_rows[index]
        entry: Model.Process
        if row.group_header {
            entry = Model.GroupProcess(raw, *grouped.groups[row.group_index])
            if selected_is_group &&
               GroupNameMatches(selected_group_name[0:selected_group_name_count], *entry) {
                selected_row = index
            }
        } else {
            entry = raw.processes[row.process_index]
            if !selected_is_group && entry.pid == selected_pid { selected_row = index }
        }
        base := index * COLUMNS
        name_base := index * NAME_WIDTH
        name_length: s32 = 0
        if row.group_header {
            if GroupExpanded(*entry) {
                store.name[name_base] = 91; store.name[name_base + 1] = 45
            } else {
                store.name[name_base] = 91; store.name[name_base + 1] = 43
            }
            store.name[name_base + 2] = 93; store.name[name_base + 3] = 32
            name_length = 4
        } else if row.group_index >= 0 {
            for indent: 0..3 { store.name[name_base + indent] = 32 }
            name_length = 4
        }
        copy_count := entry.name_count
        if copy_count > NAME_WIDTH - name_length { copy_count = NAME_WIDTH - name_length }
        if copy_count > 0 {
            for name_index: 0..copy_count - 1 {
                store.name[name_base + name_length + name_index] = entry.name[name_index]
            }
            name_length += copy_count
        }
        if row.group_header && name_length < NAME_WIDTH {
            store.name[name_base + name_length] = 32; name_length += 1
            if name_length < NAME_WIDTH { store.name[name_base + name_length] = 40; name_length += 1 }
            group_digits: [16]u8
            group_text := Number.FormatInteger(cast(s64)entry.group_count, group_digits[:])
            for byte: group_text {
                if name_length >= NAME_WIDTH { break }
                store.name[name_base + name_length] = byte
                name_length += 1
            }
            if name_length < NAME_WIDTH { store.name[name_base + name_length] = 41; name_length += 1 }
        }
        cell := index * CELL_WIDTH
        store.cell[base + Model.COLUMN_NAME] = TextView(store.name[name_base:name_base + name_length])
        if row.group_header {
            store.cell[base + Model.COLUMN_PID] = "-"
        } else {
            store.cell[base + Model.COLUMN_PID] = Number.FormatInteger(cast(s64)entry.pid,
                store.pid[index * PID_CELL_WIDTH:(index + 1) * PID_CELL_WIDTH])
        }
        #if #defined(TASKMGR_TAIJI) {
        store.cell[base + Model.COLUMN_CPU] = "n/a"
        if entry.cpu_available {
            store.cell[base + Model.COLUMN_CPU] = Model.FormatCpu(entry.cpu_percent,
                store.cpu[index * CPU_CELL_WIDTH:(index + 1) * CPU_CELL_WIDTH])
        }
        store.cell[base + Model.COLUMN_CPU_TIME] = "n/a"
        } else {
        store.cell[base + Model.COLUMN_CPU] = Model.FormatCpu(entry.cpu_percent,
            store.cpu[index * CPU_CELL_WIDTH:(index + 1) * CPU_CELL_WIDTH])
        store.cell[base + Model.COLUMN_CPU_TIME] = Model.FormatCpuTime(entry.ticks,
            store.time[cell:cell + CELL_WIDTH])
        }
        store.cell[base + Model.COLUMN_MEMORY] = "n/a"
        if !Platform.IsGuest() || entry.memory_available {
            store.cell[base + Model.COLUMN_MEMORY] = Model.FormatBytes(entry.memory_bytes,
                store.mem[index * MEMORY_CELL_WIDTH:(index + 1) * MEMORY_CELL_WIDTH])
        }
    }
}

BuildOrder :: () {
    if text_active == 0 {
        RebuildOrder(*text_stores_b)
        text_active = 1
    } else {
        RebuildOrder(*text_stores_a)
        text_active = 0
    }
}

// The Status column: a window whose process the kernel has stopped cannot
// answer, as a hung program could not on the classic task manager.
#if !#defined(TASKMGR_TAIJI) {
AppStatus :: (pid: s32) -> string {
    if pid <= 0 { return "Running" }
    snapshot := Model.Current()
    index := Model.FindProcess(snapshot, pid)
    if index >= 0 && snapshot.processes[index].state == Model.STATE_STOPPED {
        return "Not Responding"
    }
    return "Running"
}

WindowExpanded :: (id: u64) -> bool {
    if expanded_window_count > 0 {
        for index: 0..expanded_window_count - 1 {
            if expanded_windows[index] == id { return true }
        }
    }
    return false
}

ToggleWindow :: (id: u64) {
    if expanded_window_count > 0 {
        for index: 0..expanded_window_count - 1 {
            if expanded_windows[index] == id {
                expanded_window_count -= 1
                expanded_windows[index] = expanded_windows[expanded_window_count]
                return
            }
        }
    }
    if expanded_window_count >= Apps.MAX_WINDOWS { return }
    expanded_windows[expanded_window_count] = id
    expanded_window_count += 1
}

AddShares :: (shares: *Gpu.GpuShares) {
    if shares.count <= 0 { return }
    for index: 0..shares.count - 1 {
        if gpu_count >= cast(s32)gpu_pids.count { return }
        gpu_pids[gpu_count] = shares.pids[index]
        gpu_percent[gpu_count] = shares.percent[index]
        gpu_count += 1
    }
}

GpuShareFor :: (pid: s32) -> float64 {
    total: float64 = 0.0
    if gpu_count > 0 {
        for index: 0..gpu_count - 1 {
            if gpu_pids[index] == pid { total += gpu_percent[index] }
        }
    }
    return total
}

// Merges every per-process GPU source: NVML through its helper and DRM
// fdinfo of the processes the windows own. DRM is sampled only on a regular
// refresh while the tab is visible, so its rate is measured over a full
// interval. Needs owners from a preceding Model.AppUsages call.
CollectGpuShares :: (snapshot: *Model.Snapshot, sample: bool) {
    if sample && current_tab == TAB_APPLICATIONS && snapshot.count > 0 {
        owned: s32 = 0
        for index: 0..snapshot.count - 1 {
            if Model.ProcessOwner(snapshot, index) >= 0 {
                tree_pids[owned] = snapshot.processes[index].pid
                owned += 1
            }
        }
        GpuDrm.DrmSample(tree_pids[0:owned])
    }
    gpu_count = 0
    if Gpu.GpuSharesReady() { AddShares(Gpu.GpuSharesCurrent()) }
    if GpuDrm.DrmAvailable() { AddShares(GpuDrm.DrmShares()) }
    app_gpu_shown = Gpu.GpuSharesReady() || GpuDrm.DrmAvailable()
}

// Fills the CPU, Memory and GPU cells of ROW.
UsageCells :: (store: *AppText, row: s32, cpu: float64, memory: u64, gpu: float64) {
    base := row * APP_COLUMNS
    store.cell[base + APP_COLUMN_CPU] = Model.FormatCpu(cpu, store.cpu[row * CPU_CELL_WIDTH:(row + 1) * CPU_CELL_WIDTH])
    store.cell[base + APP_COLUMN_MEMORY] = Model.FormatBytes(memory, store.mem[row * MEMORY_CELL_WIDTH:(row + 1) * MEMORY_CELL_WIDTH])
    store.cell[base + APP_COLUMN_GPU] = Model.FormatCpu(gpu, store.gpu[row * CPU_CELL_WIDTH:(row + 1) * CPU_CELL_WIDTH])
}

AddWindowRow :: (store: *AppText, window: s32) {
    row := store.row_count
    if row >= APP_ROWS { return }
    entry := *store.list.windows[window]
    usage := *app_usage[window]
    store.rows[row] = AppRow.{window = window, process = -1}
    marker := "   "
    if usage.processes > 0 { marker = ifx WindowExpanded(entry.id) then "▾ " else "▸ " }
    parts: [2]string = .{marker, TextView(entry.title[0:entry.title_count])}
    base := row * APP_COLUMNS
    store.cell[base] = JoinAll(parts[:], store.task[window * TASK_WIDTH:(window + 1) * TASK_WIDTH])
    store.cell[base + 1] = AppStatus(entry.pid)
    if usage.found {
        UsageCells(store, row, usage.cpu_percent, usage.memory_bytes, usage.gpu_percent)
    } else {
        store.cell[base + APP_COLUMN_CPU] = "-"
        store.cell[base + APP_COLUMN_MEMORY] = "-"
        store.cell[base + APP_COLUMN_GPU] = "-"
    }
    if entry.id == app_selected_window && app_selected_pid < 0 { app_selected_row = row }
    store.row_count += 1
}

AddProcessRow :: (store: *AppText, window: s32, process_index: s32) {
    row := store.row_count
    if row >= APP_ROWS { return }
    process := *Model.Current().processes[process_index]
    store.rows[row] = AppRow.{window = window, process = process_index}
    digits: [16]u8
    name: [Model.NAME_CAPACITY]u8
    if process.name_count > 0 {
        for index: 0..process.name_count - 1 { name[index] = process.name[index] }
    }
    parts: [5]string = .{"      ", TextView(name[0:process.name_count]), "  (",
        Number.FormatInteger(cast(s64)process.pid, digits[:]), ")"}
    base := row * APP_COLUMNS
    store.cell[base] = JoinAll(parts[:], store.process_task[process_index * PROCESS_TASK_WIDTH:(process_index + 1) * PROCESS_TASK_WIDTH])
    store.cell[base + 1] = Model.StateName(process.state)
    UsageCells(store, row, process.cpu_percent, process.memory_bytes, GpuShareFor(process.pid))
    if store.list.windows[window].id == app_selected_window && process.pid == app_selected_pid {
        app_selected_row = row
    }
    store.row_count += 1
}

// The processes counted toward WINDOW, in PID order. Windows of one process
// share its owner slot, so each lists the same tree.
AddProcessRows :: (store: *AppText, window: s32) {
    snapshot := Model.Current()
    index := Model.FindProcess(snapshot, app_pids[window])
    if index < 0 { return }
    owner := Model.ProcessOwner(snapshot, index)
    for process: 0..snapshot.count - 1 {
        if Model.ProcessOwner(snapshot, process) == owner { AddProcessRow(store, window, process) }
    }
}

// Rebuilds the window list and its rows. SAMPLE is false when only the
// expansion changed, so GPU rates are not measured over a split second.
RebuildApps :: (store: *AppText, sample: bool) {
    Apps.AppsRefresh(*store.list)
    snapshot := Model.Current()
    count := store.list.count
    store.row_count = 0
    app_selected_row = -1
    if count > 0 {
        for index: 0..count - 1 { app_pids[index] = store.list.windows[index].pid }
        Model.AppUsages(snapshot, app_pids[0:count], gpu_pids[0:0], gpu_percent[0:0], false,
            app_usage[0:count])
        CollectGpuShares(snapshot, sample)
        Model.AppUsages(snapshot, app_pids[0:count], gpu_pids[0:gpu_count],
            gpu_percent[0:gpu_count], app_gpu_shown, app_usage[0:count])
        for window: 0..count - 1 {
            AddWindowRow(store, window)
            if WindowExpanded(store.list.windows[window].id) { AddProcessRows(store, window) }
        }
    }
    if app_selected_row < 0 {
        app_selected_window = 0
        app_selected_pid = -1
    }
}

BuildApps :: (sample: bool = true) {
    if app_active == 0 {
        RebuildApps(*app_stores_b, sample)
        app_active = 1
    } else {
        RebuildApps(*app_stores_a, sample)
        app_active = 0
    }
}

ActiveAppText :: () -> *AppText {
    if app_active == 0 { return *app_stores_a }
    return *app_stores_b
}

// Task, Status, CPU and Memory, plus GPU when a source has data.
AppColumnCount :: () -> s32 {
    return ifx app_gpu_shown then APP_COLUMNS else APP_COLUMNS - 1
}

} else {
BuildApps :: (sample: bool = true) {}
}

// Copies the message parts into the raw status bytes for later frames.
SetStatus :: (parts: []string) {
    length: s32 = 0
    for part: parts {
        for byte: part {
            if length >= STATUS_WIDTH { break }
            status_bytes[length] = byte
            length += 1
        }
    }
    status_length = length
}

SetStatusText :: (text: string) {
    parts: [1]string = .{text}
    SetStatus(parts[:])
}

ColumnWidths :: (width: float32) {
    if widths_for == width && widths_gpu == app_gpu_shown { return }
    widths_for = width
    widths_gpu = app_gpu_shown
    usable := width - 18.0
    for column: 0..COLUMNS - 1 {
        value := cast(s32)(usable * process_fractions[column])
        if value < 40 { value = 40 }
        process_widths[column] = value
    }
    for column: 0..APP_COLUMNS - 1 {
        fraction := app_fractions[column]
        // Without a GPU column its share goes to the Task names.
        if column == 0 && !app_gpu_shown { fraction += app_fractions[APP_COLUMN_GPU] }
        value := cast(s32)(usable * fraction)
        if value < 40 { value = 40 }
        app_widths[column] = value
    }
}

MenuBar :: (session: Session, bounds: Rectangle) -> s32 {
    if !menu_state.initialized { Menu.MenuStateInit(*menu_state) }
    file_items: [3]Menu.MenuItem
    file_items[0].id = MENU_NEW_TASK
    file_items[0].label = "New Task (Run...)"
    file_items[0].disabled = Platform.IsGuest()
    file_items[1].kind = Menu.MenuItemKind.MenuSeparator
    file_items[2].id = MENU_EXIT
    file_items[2].label = "Exit Task Manager"

    option_items: [2]Menu.MenuItem
    option_items[0].kind = Menu.MenuItemKind.MenuCheck
    option_items[0].id = MENU_CONFIRM_END
    option_items[0].label = "Confirm Before Ending Processes"
    option_items[0].checked = confirm_end
    option_items[1].kind = Menu.MenuItemKind.MenuCheck
    option_items[1].id = MENU_GROUP_PROCESSES
    option_items[1].label = "Group Processes"
    option_items[1].checked = group_processes
    option_items[1].disabled = Platform.IsGuest()

    speed_items: [4]Menu.MenuItem
    speed_labels: [4]string = .{"High", "Normal", "Low", "Paused"}
    speed_values: [4]s64 = .{SPEED_HIGH_MS, SPEED_NORMAL_MS, SPEED_LOW_MS, 0}
    for index: 0..3 {
        speed_items[index].kind = Menu.MenuItemKind.MenuRadio
        speed_items[index].id = MENU_SPEED_HIGH + cast(s32)index
        speed_items[index].label = speed_labels[index]
        speed_items[index].checked = refresh_interval_ms == speed_values[index]
    }
    view_items: [4]Menu.MenuItem
    view_items[0].id = MENU_REFRESH
    view_items[0].label = "Refresh Now"
    view_items[1].kind = Menu.MenuItemKind.MenuSubmenu
    view_items[1].label = "Update Speed"
    view_items[1].submenu = speed_items[:]
    view_items[2].kind = Menu.MenuItemKind.MenuSeparator
    view_items[3].kind = Menu.MenuItemKind.MenuCheck
    view_items[3].id = MENU_KERNEL_TIMES
    view_items[3].label = "Show Kernel Times"
    view_items[3].checked = show_kernel_times

    help_items: [1]Menu.MenuItem
    help_items[0].id = MENU_ABOUT
    help_items[0].label = "About Task Manager"

    groups: [4]Menu.MenuGroup
    groups[0].label = "File"
    groups[0].items = file_items[:]
    groups[1].label = "Options"
    groups[1].items = option_items[:]
    groups[2].label = "View"
    groups[2].items = view_items[:]
    groups[3].label = "Help"
    groups[3].items = help_items[:]
    return Menu.Draw(session, Menu.Props.{.key = 20, .bounds = bounds}, groups[:], *menu_state).activated_id
}

RunMenu :: (id: s32) {
    if id == MENU_NEW_TASK { OpenRunDialog() }
    if id == MENU_EXIT { Platform.CloseWindow() }
    if id == MENU_CONFIRM_END { confirm_end = !confirm_end }
    if id == MENU_GROUP_PROCESSES && !Platform.IsGuest() {
        group_processes = !group_processes
        selected_row = -1
        selected_pid = -1
        selected_is_group = false
        selected_group_name_count = 0
        selected_column = -1
        scroll_offset = 0
        pending_sort = true
    }
    if id == MENU_REFRESH { refresh_requested = true }
    if id == MENU_SPEED_HIGH { refresh_interval_ms = SPEED_HIGH_MS }
    if id == MENU_SPEED_NORMAL { refresh_interval_ms = SPEED_NORMAL_MS }
    if id == MENU_SPEED_LOW { refresh_interval_ms = SPEED_LOW_MS }
    if id == MENU_SPEED_PAUSED { refresh_interval_ms = 0 }
    if id == MENU_KERNEL_TIMES { show_kernel_times = !show_kernel_times }
    if id == MENU_ABOUT { dialog = DIALOG_ABOUT }
}

OpenRunDialog :: () {
    if Platform.IsGuest() { SetStatusText("Task launch unavailable on Taiji."); return }
    dialog = DIALOG_RUN
    command_pending = false
    command_length = 0
    command_cursor = 0
    command_anchor = 0
    command_scroll = 0
}

// Writes the field's text with one edit applied into command_next; the next
// frame's SettleCommand copies it back.
ApplyEdit :: (length: s32, edit: TextField.Edit) -> s32 {
    if !edit.changed { return length }
    if edit.start < 0 || edit.end < edit.start || edit.end > length { return length }
    new_length := length - (edit.end - edit.start) + cast(s32)edit.replacement.count
    if new_length > Model.COMMAND_CAPACITY { return length }
    at: s32 = 0
    if edit.start > 0 {
        for index: 0..edit.start - 1 { command_next[at] = command_bytes[index]; at += 1 }
    }
    for byte: edit.replacement { command_next[at] = byte; at += 1 }
    if edit.end < length {
        for index: edit.end..length - 1 { command_next[at] = command_bytes[index]; at += 1 }
    }
    command_pending = true
    return new_length
}

// Moves the previous frame's edit into the field's text before any view of
// it is taken this frame.
SettleCommand :: () {
    if !command_pending { return }
    if command_length > 0 {
        for index: 0..command_length - 1 { command_bytes[index] = command_next[index] }
    }
    command_pending = false
}

RunCommand :: () {
    SettleCommand()
    command := TextView(command_bytes[0:command_length])
    if Model.StartTask(command) {
        parts: [2]string = .{"Started ", command}
        SetStatus(parts[:])
        refresh_requested = true
    } else {
        SetStatusText("Could not start that command.")
    }
    dialog = DIALOG_NONE
}

RunDialog :: (session: Session, font: s32) {
    SettleCommand()
    modal := Modal.Draw(session, Modal.Props.{.key = 300, .title = "Create New Task",
        .width = 460, .height = 210, .left_label = "Cancel", .right_label = "OK",
        .has_left_action = true, .has_right_action = true})
    commit := modal.right_clicked
    if modal.opened {
        area := modal.layout.content
        Label(session, 301, "Type the command to run. It starts in the background.",
            .{area.x, area.y, area.width, 22.0}, font)
        key := KeyboardTake(session)
        text := TypedTextTake(session, typed[:])
        input := TextFieldInputFor(key, KeyboardModifiers(session), text)
        result := TextField.Draw(session, TextField.Props.{.key = 302, .id = 302,
            .bounds = .{area.x, area.y + 30.0, area.width, 36.0},
            .value = TextView(command_bytes[0:command_length]), .label = "Open",
            .placeholder = "for example: xterm", .max_bytes = Model.COMMAND_CAPACITY,
            .cursor = command_cursor, .anchor = command_anchor, .scroll_x = command_scroll,
            .focused = true, .input = input})
        command_cursor = result.cursor
        command_anchor = result.anchor
        command_scroll = result.scroll_x
        command_length = ApplyEdit(command_length, result.edit)
        if result.committed { commit = true }
        if result.escaped { dialog = DIALOG_NONE }
        unused End(session)
    }
    if modal.dismissed || modal.left_clicked { dialog = DIALOG_NONE }
    if commit && dialog == DIALOG_RUN { RunCommand() }
}

AboutDialog :: (session: Session) {
    actions: [1]Modal.ActionModalAction
    actions[0].label = "OK"
    actions[0].tone = ButtonTone.ButtonToneAccent
    actions[0].emphasis = ButtonEmphasis.ButtonEmphasisFilled
    answer := Modal.ActionModal(session, Modal.ActionModalProps.{.key = 310, .title = "About Task Manager",
        .message = "taskmgr shows the applications, processes and performance of this Linux computer. It reads /proc directly and lists windows from the X11 window manager.",
        .max_width = 440}, actions[:])
    if answer.action != 0 { dialog = DIALOG_NONE }
}

EndSelectedProcess :: () {
    snapshot := Model.Current()
    index := Model.FindProcess(snapshot, end_pid)
    if index < 0 {
        SetStatusText("That process has already exited.")
        return
    }
    target := snapshot.processes[index]
    name_length := target.name_count
    if name_length > NAME_WIDTH { name_length = NAME_WIDTH }
    name_line: [NAME_WIDTH]u8
    if name_length > 0 {
        for name_index: 0..name_length - 1 { name_line[name_index] = target.name[name_index] }
    }
    pid_line: [16]u8
    pid_text := Number.FormatInteger(cast(s64)target.pid, pid_line[:])
    if Model.EndTask(target.pid) {
        refresh_requested = true
        parts: [5]string = .{"Sent stop signal to ", TextView(name_line[0:name_length]),
            " (PID ", pid_text, ")"}
        SetStatus(parts[:])
    } else {
        SetStatusText("Could not end the selected process.")
    }
}

FindNamedGroup :: (snapshot: *Model.GroupedSnapshot, name: []u8) -> s32 {
    raw := Model.Current()
    if snapshot.count > 0 {
        for index: 0..snapshot.count - 1 {
            group := Model.GroupProcess(raw, *snapshot.groups[index])
            if GroupNameMatches(name, *group) { return index }
        }
    }
    return -1
}

EndSelectedGroup :: () {
    grouped := Model.GroupedCurrent()
    index := FindNamedGroup(grouped, end_group_name[0:end_group_name_count])
    if index < 0 {
        SetStatusText("That process group has already exited.")
        return
    }
    raw := Model.Current()
    group := Model.GroupProcess(raw, *grouped.groups[index])
    result := Model.EndProcessGroup(raw, *group)
    sent_line: [16]u8
    failed_line: [16]u8
    name_line := TextView(end_group_name[0:end_group_name_count])
    if result.requested == 0 {
        SetStatusText("That process group has already exited.")
    } else if result.failed == 0 {
        parts: [5]string = .{"Sent stop signal to ",
            Number.FormatInteger(cast(s64)result.sent, sent_line[:]),
            " processes in group ", name_line, "."}
        SetStatus(parts[:])
        refresh_requested = true
    } else {
        parts: [7]string = .{"Stopped ",
            Number.FormatInteger(cast(s64)result.sent, sent_line[:]), " processes in ",
            name_line, "; ", Number.FormatInteger(cast(s64)result.failed, failed_line[:]), " failed."}
        SetStatus(parts[:])
        refresh_requested = true
    }
}

EndSelectedTarget :: () {
    if end_is_group { EndSelectedGroup() } else { EndSelectedProcess() }
}

EndProcessDialog :: (session: Session) {
    group_message_line: [256]u8
    process_message_line: [256]u8
    message: string
    if end_is_group {
        count_line: [16]u8
        parts: [5]string = .{"Ending a process group can lose unsaved data. End all ",
            Number.FormatInteger(cast(s64)end_group_members, count_line[:]),
            " processes in group ", TextView(end_group_name[0:end_group_name_count]), "?"}
        message = JoinAll(parts[:], group_message_line[:])
    } else {
        snapshot := Model.Current()
        index := Model.FindProcess(snapshot, end_pid)
        name_line: [NAME_WIDTH]u8
        name_length: s32 = 0
        if index >= 0 {
            name_length = snapshot.processes[index].name_count
            if name_length > NAME_WIDTH { name_length = NAME_WIDTH }
            if name_length > 0 {
                for name_index: 0..name_length - 1 {
                    name_line[name_index] = snapshot.processes[index].name[name_index]
                }
            }
        }
        pid_line: [16]u8
        parts: [5]string = .{"Ending a process can lose unsaved data or leave the system unstable. End ",
            TextView(name_line[0:name_length]), " (PID ",
            Number.FormatInteger(cast(s64)end_pid, pid_line[:]), ")?"}
        message = JoinAll(parts[:], process_message_line[:])
    }
    actions: [2]Modal.ActionModalAction
    actions[0].label = "No"
    actions[1].label = "Yes"
    actions[1].tone = ButtonTone.ButtonToneDanger
    actions[1].emphasis = ButtonEmphasis.ButtonEmphasisFilled
    answer := Modal.ActionModal(session, Modal.ActionModalProps.{.key = 320, .title = "Task Manager Warning",
        .message = message, .max_width = 460}, actions[:])
    if answer.action == 2 { EndSelectedTarget() }
    if answer.action != 0 { dialog = DIALOG_NONE }
}

ApplicationsTab :: (session: Session, area: Rectangle) {
#if #defined(TASKMGR_TAIJI) {
    CenteredLabel(session, 205, "Window task lists are unavailable on TaijiOS.", area, 14)
} else {
    store := ActiveAppText()
    list := *store.list
    table_bounds := Rectangle.{area.x, area.y, area.width, area.height - BUTTON_HEIGHT - PAD}
    if table_bounds.height < 60.0 { table_bounds.height = 60.0 }
    rows: [APP_ROWS]Tables.TableRow
    count := store.row_count
    shown := AppColumnCount()
    if count > 0 {
        for index: 0..count - 1 {
            base := index * APP_COLUMNS
            if app_active == 0 {
                rows[index].cells = app_stores_a.cell[base:base + shown]
            } else {
                rows[index].cells = app_stores_b.cell[base:base + shown]
            }
        }
    }
    table := Tables.TableView(session, Tables.TableViewProps.{.key = 200,
        .bounds = table_bounds, .columns = app_columns[0:shown], .rows = rows[0:count],
        .column_widths = app_widths[0:shown], .selected_row = app_selected_row,
        .selected_column = -1, .sort_column = -1,
        .scroll_offset = app_scroll_offset, .row_height = 26, .header_height = 30,
        .resizable = true})
    app_selected_row = table.selected_row
    app_scroll_offset = table.scroll_offset
    app_selected_window = 0
    app_selected_pid = -1
    if app_selected_row >= 0 && app_selected_row < count {
        row := store.rows[app_selected_row]
        app_selected_window = list.windows[row.window].id
        if row.process >= 0 {
            app_selected_pid = Model.Current().processes[row.process].pid
        } else if table.clicked_row == app_selected_row && app_usage[row.window].processes > 0 {
            // Clicking a window shows or hides the processes it owns.
            ToggleWindow(app_selected_window)
            apps_layout_changed = true
        }
    }
    if !list.available {
        CenteredLabel(session, 205, "No window manager task list is available on this display.",
            .{table_bounds.x, table_bounds.y + 60.0, table_bounds.width, 24.0}, 14)
    }

    button_y := area.y + area.height - BUTTON_HEIGHT
    right := area.x + area.width
    none := app_selected_window == 0
    if TaskButton(session, 210, "End Task", .{right - BUTTON_WIDTH * 3.0 - 16.0, button_y,
            BUTTON_WIDTH, BUTTON_HEIGHT}, false, none) && !none {
        if Apps.AppsCloseWindow(app_selected_window) {
            SetStatusText("Asked the window to close.")
            refresh_requested = true
        } else {
            SetStatusText("Could not reach the window manager.")
        }
    }
    if TaskButton(session, 211, "Switch To", .{right - BUTTON_WIDTH * 2.0 - 8.0, button_y,
            BUTTON_WIDTH, BUTTON_HEIGHT}, false, none) && !none {
        if !Apps.AppsSwitchTo(app_selected_window) { SetStatusText("Could not reach the window manager.") }
    }
    if TaskButton(session, 212, "New Task...", .{right - BUTTON_WIDTH, button_y,
            BUTTON_WIDTH, BUTTON_HEIGHT}, false, false) {
        OpenRunDialog()
    }
}
}

ProcessesTab :: (session: Session, area: Rectangle) {
    raw := Model.Current()
    if !raw.processes_available {
        Label(session, 109, "Guest process service unavailable", area, 14)
        return
    }
    grouped_snapshot := Model.GroupedCurrent()
    table_bounds := Rectangle.{area.x, area.y, area.width, area.height - BUTTON_HEIGHT - PAD}
    if table_bounds.height < 60.0 { table_bounds.height = 60.0 }
    table_rows: [MAX_DISPLAY_ROWS]Tables.TableRow
    if text_active == 0 {
        if display_count > 0 {
            for index: 0..display_count - 1 {
                table_rows[index].cells = text_stores_a.cell[index * COLUMNS:(index + 1) * COLUMNS]
            }
        }
    } else {
        if display_count > 0 {
            for index: 0..display_count - 1 {
                table_rows[index].cells = text_stores_b.cell[index * COLUMNS:(index + 1) * COLUMNS]
            }
        }
    }
    table := Tables.TableView(session, Tables.TableViewProps.{.key = 100,
        .bounds = table_bounds, .columns = process_columns[:], .rows = table_rows[0:display_count],
        .column_widths = process_widths[:], .selected_row = selected_row,
        .selected_column = -1, .sort_column = sort_column,
        .sort_direction = sort_direction, .scroll_offset = scroll_offset,
        .row_height = 26, .header_height = 30, .resizable = true})
    selected_row = table.selected_row
    // A process is a row, not a cell: every column keeps the selected face.
    selected_column = -1
    scroll_offset = table.scroll_offset
    selected_pid = -1
    selected_is_group = false
    selected_group_name_count = 0
    if selected_row >= 0 && selected_row < display_count {
        row := display_rows[selected_row]
        if row.group_header {
            group := Model.GroupProcess(raw, *grouped_snapshot.groups[row.group_index])
            selected_is_group = true
            selected_group_name_count = CopyGroupName(*group, selected_group_name[:])
            if table.clicked_row == selected_row && group.group_count > 1 {
                ToggleGroup(*group)
                pending_sort = true
            }
        } else {
            selected_pid = raw.processes[row.process_index].pid
        }
    }
    if table.sort_column != sort_column || table.sort_direction != sort_direction {
        sort_column = table.sort_column
        sort_direction = table.sort_direction
        pending_sort = true
    }

    button_y := area.y + area.height - BUTTON_HEIGHT
    none := (Platform.IsGuest() && selected_is_group) || (selected_pid <= 0 && !selected_is_group)
    button_label: string = "End Process"
    if selected_is_group { button_label = "End Group" }
    if TaskButton(session, 110, button_label, .{area.x + area.width - BUTTON_WIDTH, button_y,
            BUTTON_WIDTH, BUTTON_HEIGHT}, false, none) && !none {
        end_is_group = selected_is_group
        if end_is_group {
            end_group_name_count = selected_group_name_count
            if end_group_name_count > 0 {
                for index: 0..end_group_name_count - 1 {
                    end_group_name[index] = selected_group_name[index]
                }
            }
            group_index := FindNamedGroup(grouped_snapshot,
                end_group_name[0:end_group_name_count])
            end_group_members = 0
            if group_index >= 0 {
                end_group_members = grouped_snapshot.groups[group_index].group_count
            }
        } else {
            end_pid = selected_pid
        }
        if confirm_end { dialog = DIALOG_END_PROCESS } else { EndSelectedTarget() }
    }
}

GraphColor :: (kind: s32, series: s32) -> u32 {
    // Windows' classic performance palette on black: CPU green, memory
    // yellow, and stable per-adapter cyan/orange/violet/blue graphics traces.
    if kind == Model.HISTORY_CPU { return cast(u32)0x00ff00ff }
    if kind == Model.HISTORY_MEMORY { return cast(u32)0xffff00ff }
    palette: [6]u32 = .{cast(u32)0x00ffffff, cast(u32)0xff9900ff,
        cast(u32)0xcc66ffff, cast(u32)0x3399ffff,
        cast(u32)0xff66ccff, cast(u32)0x99ff66ff}
    return palette[series % 6]
}

DrawHistorySeries :: (session: Session, inner: Rectangle, series: []float32, color: u32) {
    count := cast(s32)series.count
    if count > 1 {
        for index: 1..count - 1 {
            x0 := inner.x + inner.width * cast(float32)(index - 1) / cast(float32)(count - 1)
            x1 := inner.x + inner.width * cast(float32)index / cast(float32)(count - 1)
            y0 := inner.y + inner.height * (1.0 - series[index - 1] / 100.0)
            y1 := inner.y + inner.height * (1.0 - series[index] / 100.0)
            PaintLine(session, -1, .{x0, y0, x1 - x0, y1 - y0}, ColorFromPacked(color))
        }
    }
}

GpuLegend :: (device: *Model.GpuDevice, kind: s32, output: []u8) -> string {
    card_digits: [16]u8
    length: s32 = 0
    length = AppendText(output, length, "card")
    length = AppendText(output, length,
        Number.FormatInteger(cast(s64)device.card_index, card_digits[:]))
    length = AppendText(output, length, ": ")
    if kind == Model.HISTORY_GPU {
        if !device.busy_supported { length = AppendText(output, length, "n/a") }
        else {
            percent: [16]u8
            length = AppendText(output, length, Model.FormatCpu(device.busy_percent, percent[:]))
            length = AppendText(output, length, "%")
        }
    } else {
        if !device.vram_supported { length = AppendText(output, length, "n/a") }
        else {
            used: [32]u8
            total: [32]u8
            length = AppendText(output, length, Model.FormatBytes(device.vram_used, used[:]))
            length = AppendText(output, length, " / ")
            length = AppendText(output, length, Model.FormatBytes(device.vram_total, total[:]))
        }
    }
    return TextView(output[0:length])
}

HistoryGraph :: (session: Session, key: s32, bounds: Rectangle, label: string, kind: s32,
    font: s32, with_kernel: bool) {
    border := GraphColor(kind, 0)
    Box.Draw(session, Box.Props.{.key = cast(u64)key, .bounds = bounds,
        .fill = ColorFromPacked(cast(u32)0x000000ff),
        .border = ColorFromPacked(border), .radius = 0.0})
    inner := Rectangle.{bounds.x + 2.0, bounds.y + 2.0,
        bounds.width - 4.0, bounds.height - 4.0}
    if kind == Model.HISTORY_GPU || kind == Model.HISTORY_VRAM {
        snapshot := Model.Current()
        if snapshot.gpu_count > 0 {
            for device_index: 0..snapshot.gpu_count - 1 {
                device := *snapshot.gpus[device_index]
                supported := device.busy_supported
                if kind == Model.HISTORY_VRAM { supported = device.vram_supported }
                color := GraphColor(kind, device_index)
                if supported {
                    values: [Model.HISTORY_LENGTH]float32
                    series := Model.GpuHistory(kind, device.card_index, values[:])
                    DrawHistorySeries(session, inner, series, color)
                }
                // A compact colored legend identifies every detected card,
                // including adapters whose driver exposes no metric.
                legend: [64]u8
                row := Rectangle.{inner.x + 3.0,
                    inner.y + 2.0 + cast(float32)device_index * 16.0,
                    inner.width - 6.0, 15.0}
                PaintLine(session, -1, .{row.x + 3.0, row.y + 7.0, 8.0, 0.0},
                    ColorFromPacked(color))
                PaintClippedLabel(session, -1, GpuLegend(device, kind, legend[:]),
                    cast(s32)(row.x + 15.0), cast(s32)row.y, font,
                    ColorFromPacked(color), inner)
            }
        }
    } else {
        values: [Model.HISTORY_LENGTH]float32
        series := Model.History(kind, values[:])
        DrawHistorySeries(session, inner, series, GraphColor(kind, 0))
        if with_kernel {
            kernel_values: [Model.HISTORY_LENGTH]float32
            kernel := Model.History(Model.HISTORY_KERNEL, kernel_values[:])
            DrawHistorySeries(session, inner, kernel, cast(u32)0xff0000ff)
        }
    }
    unused label
}

// One "Label    value" row inside a group box.
InfoRow :: (session: Session, key: s32, area: Rectangle, row: s32, label: string, value: string,
    font: s32) {
    y := area.y + cast(float32)row * 20.0
    Label(session, key, label, .{area.x, y, area.width * 0.55, 18.0}, font)
    ValueLabel(session, key + 1, value, .{area.x + area.width * 0.45, y, area.width * 0.55, 18.0}, font)
}

GroupContent :: (bounds: Rectangle) -> Rectangle {
    return .{bounds.x + 12.0, bounds.y + 22.0, bounds.width - 24.0, bounds.height - 30.0}
}

PerformanceGraph :: (session: Session, key: s32, bounds: Rectangle, title: string,
    semantic_label: string, history_kind: s32, reading: string, font: s32,
    with_kernel: bool) {
    Fieldset.Draw(session, Fieldset.Props.{.key = cast(u64)key, .bounds = bounds, .title = title})
    content := GroupContent(bounds)
    reading_height: float32 = 18.0
    graph := Rectangle.{content.x, content.y, content.width, content.height - reading_height - 3.0}
    if graph.height < 20.0 { graph.height = 20.0 }
    HistoryGraph(session, key + 1, graph, semantic_label, history_kind, font, with_kernel)
    CenteredLabel(session, key + 2, reading,
        .{content.x, graph.y + graph.height + 3.0, content.width, reading_height}, font)
}

PerformanceTab :: (session: Session, area: Rectangle, font: s32) {
    #if #defined(TASKMGR_TAIJI) {
        bytes: [32]u8
        Label(session, 449, "Guest main pool allocated", area, font)
        reading := "n/a"
        if Model.Current().memory_available { reading = Model.FormatBytes(Model.Current().memory_used, bytes[:]) }
        Label(session, 450, reading,
            .{area.x, area.y + 40.0, area.width, 30.0}, font)
        measured_bytes: [16]u8
        all_bytes: [16]u8
        count_bytes: [80]u8
        count_parts: [4]string = .{"Comparable tasks: ",
            Number.FormatInteger(cast(s64)Model.Current().cpu_measured_tasks, measured_bytes[:]),
            " / ", Number.FormatInteger(cast(s64)Model.Current().count, all_bytes[:])}
        Label(session, 453, JoinAll(count_parts[:], count_bytes[:]),
            .{area.x, area.y + 160.0, area.width, 30.0}, font)
        cpu_bytes: [24]u8
        cpu_reading := "n/a (sampling)"
        if Model.Current().cpu_available { cpu_reading = Model.FormatAccountedCpu(Model.Current().cpu_percent, cpu_bytes[:]) }
        Label(session, 451, "Measured task CPU % (one core = 100%)",
            .{area.x, area.y + 90.0, area.width, 30.0}, font)
        Label(session, 452, cpu_reading,
            .{area.x, area.y + 125.0, area.width, 30.0}, font)
    } else {
    snapshot := Model.Current()
        half := (area.width - PAD) / 2.0
        info_height: float32 = 92.0
        info_block := info_height * 2.0 + PAD
        graph_block := area.height - info_block - PAD
        graph_height := (graph_block - PAD) / 2.0
        if graph_height < 72.0 { graph_height = 72.0 }
        right_x := area.x + half + PAD
        second_graph_y := area.y + graph_height + PAD

        cpu_digits: [16]u8
        cpu_text: [24]u8
        cpu_parts: [2]string = .{Model.FormatCpu(snapshot.cpu_percent, cpu_digits[:]), "%"}
        PerformanceGraph(session, 400, .{area.x, area.y, half, graph_height},
            "CPU Usage History", "CPU usage history", Model.HISTORY_CPU,
            JoinAll(cpu_parts[:], cpu_text[:]), font, show_kernel_times)

        memory_used: [32]u8
        PerformanceGraph(session, 410, .{right_x, area.y, half, graph_height},
            "Memory Usage History", "memory usage history", Model.HISTORY_MEMORY,
            Model.FormatBytes(snapshot.memory_used, memory_used[:]), font, false)

        gpu_reading: string = "n/a"
        gpu_digits: [16]u8
        gpu_text: [24]u8
        if snapshot.gpu_supported_count > 0 {
            gpu_parts: [2]string = .{Model.FormatCpu(snapshot.gpu_percent, gpu_digits[:]), "%"}
            gpu_reading = JoinAll(gpu_parts[:], gpu_text[:])
        }
        PerformanceGraph(session, 420, .{area.x, second_graph_y, half, graph_height},
            "GPU Usage History", "GPU usage history", Model.HISTORY_GPU,
            gpu_reading, font, false)

        vram_reading: string = "n/a"
        vram_used: [32]u8
        vram_total: [32]u8
        vram_text: [80]u8
        if snapshot.vram_total > 0 {
            vram_parts: [3]string = .{Model.FormatBytes(snapshot.vram_used, vram_used[:]),
                " / ", Model.FormatBytes(snapshot.vram_total, vram_total[:])}
            vram_reading = JoinAll(vram_parts[:], vram_text[:])
        }
        PerformanceGraph(session, 430, .{right_x, second_graph_y, half, graph_height},
            "VRAM Usage History", "VRAM usage history", Model.HISTORY_VRAM,
            vram_reading, font, false)

        info_y := second_graph_y + graph_height + PAD
        details := snapshot.memory
        a: [32]u8
        b: [32]u8
        c: [32]u8
        totals := Rectangle.{area.x, info_y, half, info_height}
        Fieldset.Draw(session, Fieldset.Props.{.key = 440, .bounds = totals, .title = "Totals"})
        totals_area := GroupContent(totals)
        InfoRow(session, 441, totals_area, 0, "Handles", Model.FormatThousands(snapshot.handles, a[:]), font)
        InfoRow(session, 443, totals_area, 1, "Threads", Model.FormatThousands(snapshot.threads, b[:]), font)
        InfoRow(session, 445, totals_area, 2, "Processes", Model.FormatThousands(cast(s64)snapshot.count, c[:]), font)

        physical := Rectangle.{right_x, info_y, half, info_height}
        Fieldset.Draw(session, Fieldset.Props.{.key = 450, .bounds = physical, .title = "Physical Memory"})
        physical_area := GroupContent(physical)
        d: [32]u8
        e: [32]u8
        f: [32]u8
        InfoRow(session, 451, physical_area, 0, "Total", Model.FormatKilobytesBytes(details.total_kb, d[:]), font)
        InfoRow(session, 453, physical_area, 1, "Available", Model.FormatKilobytesBytes(details.available_kb, e[:]), font)
        InfoRow(session, 455, physical_area, 2, "System Cache", Model.FormatKilobytesBytes(details.cache_kb, f[:]), font)

        second_info_y := info_y + info_height + PAD
        commit := Rectangle.{area.x, second_info_y, half, info_height}
        Fieldset.Draw(session, Fieldset.Props.{.key = 460, .bounds = commit, .title = "Commit Charge"})
        commit_area := GroupContent(commit)
        g: [32]u8
        h: [32]u8
        i: [32]u8
        InfoRow(session, 461, commit_area, 0, "Total", Model.FormatKilobytesBytes(details.commit_kb, g[:]), font)
        InfoRow(session, 463, commit_area, 1, "Limit", Model.FormatKilobytesBytes(details.commit_limit_kb, h[:]), font)
        InfoRow(session, 465, commit_area, 2, "Peak", Model.FormatKilobytesBytes(Model.CommitPeakKb(), i[:]), font)

        kernel := Rectangle.{right_x, second_info_y, half, info_height}
        Fieldset.Draw(session, Fieldset.Props.{.key = 470, .bounds = kernel, .title = "Kernel Memory"})
        kernel_area := GroupContent(kernel)
        j: [32]u8
        k: [32]u8
        l: [32]u8
        kernel_total: s64 = -1
        if details.kernel_paged_kb >= 0 && details.kernel_nonpaged_kb >= 0 {
            kernel_total = details.kernel_paged_kb + details.kernel_nonpaged_kb
        }
        InfoRow(session, 471, kernel_area, 0, "Total", Model.FormatKilobytesBytes(kernel_total, j[:]), font)
        InfoRow(session, 473, kernel_area, 1, "Paged", Model.FormatKilobytesBytes(details.kernel_paged_kb, k[:]), font)
        InfoRow(session, 475, kernel_area, 2, "Nonpaged", Model.FormatKilobytesBytes(details.kernel_nonpaged_kb, l[:]), font)
    }
}

// The status bar: process count, CPU usage and memory in use, each in its
// own sunken pane as on the classic task manager.
StatusBar :: (session: Session, bounds: Rectangle, font: s32) {
    theme := Theme.CurrentTheme()
    snapshot := Model.Current()
    Box.Draw(session, Box.Props.{.key = 500, .bounds = bounds, .fill = ColorFromPacked(PaletteLayer(5)),
        .border = ColorFromPacked(palette_border)})
    count_line: [16]u8
    processes_line: [48]u8
    processes_parts: [2]string = .{"Processes: ", Number.FormatInteger(cast(s64)snapshot.count, count_line[:])}
    cpu_line: [16]u8
    cpu_text: [48]u8
    cpu_value := ""
    cpu_caption := "CPU Usage: "
#if #defined(TASKMGR_TAIJI) {
    cpu_value = Model.FormatAccountedCpu(snapshot.cpu_percent, cpu_line[:])
    cpu_caption = "Task CPU: "
} else {
    cpu_value = Model.FormatCpu(snapshot.cpu_percent, cpu_line[:])
}
    cpu_parts: [3]string = .{cpu_caption, cpu_value, "%"}
    used_line: [32]u8
    total_line: [32]u8
    memory_text: [96]u8
    memory_parts: [4]string = .{"Mem Usage: ", Model.FormatBytes(snapshot.memory_used, used_line[:]),
        " / ", Model.FormatBytes(snapshot.memory_total, total_line[:])}
    texts: [3]string = .{JoinAll(processes_parts[:], processes_line[:]),
        JoinAll(cpu_parts[:], cpu_text[:]), JoinAll(memory_parts[:], memory_text[:])}
    if !snapshot.processes_available { texts[0] = "Processes: n/a" }
    if !snapshot.cpu_available { texts[1] = "CPU: n/a" }
#if #defined(TASKMGR_TAIJI) {
    if !snapshot.cpu_available { texts[1] = "Task CPU: n/a" }
}
    if !snapshot.memory_available { texts[2] = "Memory: n/a" }
#if #defined(TASKMGR_TAIJI) {
    widths: [3]float32 = .{0.24, 0.32, 0.44}
} else {
    widths: [3]float32 = .{0.24, 0.24, 0.52}
}
    x := bounds.x + 4.0
    for index: 0..2 {
        width := (bounds.width - 16.0) * widths[index]
        pane := Rectangle.{x, bounds.y + 3.0, width, bounds.height - 6.0}
        Box.Draw(session, Box.Props.{.key = cast(u64)(501 + cast(s32)index * 2), .bounds = pane,
            .fill = ColorFromPacked(palette_background), .border = ColorFromPacked(palette_border),
            .radius = theme.metrics.radius_mark})
        Label(session, 502 + cast(s32)index * 2, texts[index], .{pane.x + 6.0, pane.y + 2.0, pane.width - 12.0,
            pane.height - 4.0}, font)
        x += width + 4.0
    }
}

TaskTabs :: (session: Session, bounds: Rectangle) {
    labels: [3]string = .{"Applications", "Processes", "Performance"}
    gap: float32 = 4.0
    width := (bounds.width - gap * 2.0) / 3.0
    for index: 0..2 {
        if TaskButton(session, 50 + cast(s32)index, labels[index],
            .{bounds.x + cast(float32)index * (width + gap), bounds.y, width, bounds.height},
            current_tab == index, false) {
            current_tab = cast(s32)index
        }
    }
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    if !started {
        #if !#defined(TASKMGR_TAIJI) {
        unused ThemeXInitThreads()
        palette := SystemThemeHostLinux.SystemPaletteRead()
        // Some GTK/host themes report the window background correctly but
        // return a white input "base" and an inconsistent darkness flag.
        // Task Manager is a single system panel, so keep its panel base on the
        // actual system window background. Text, borders and selection still
        // come from the rest of the system palette.
        palette.base = palette.background
        palette_background = palette.background
        palette_base = palette.base
        palette_text = palette.text
        palette_border = palette.border
        unused SystemTheme.SystemPaletteInstall(palette)
        }
        #if #defined(TASKMGR_TAIJI) {
            theme := Theme.CurrentTheme()
            palette_background = theme.colors.background
            palette_text = theme.colors.foreground
            palette_border = theme.colors.border
            palette_base = palette_background
            process_columns[2] = "CPU %"
            process_columns[4] = "Est. Memory"
            group_processes = false
        }
        current_tab = StartingTab()
        started = true
    }
    frames_since_refresh += 1
    now_ms: s64 = -1
    #if !#defined(TASKMGR_TAIJI) {
        now_ms = Timer.MonotonicMilliseconds()
    } else {
        now_ms = GuestClock.Milliseconds()
    }
    refreshed := last_refresh_ms < 0
    if refresh_interval_ms > 0 {
        if now_ms >= 0 && last_refresh_ms >= 0 &&
           (now_ms < last_refresh_ms || now_ms - last_refresh_ms >= refresh_interval_ms) {
            refreshed = true
        }
        if now_ms < 0 && frames_since_refresh >= REFRESH_FALLBACK_FRAMES { refreshed = true }
    }
    if refresh_requested { refreshed = true }
    // Non-blocking: drains the GPU helper, and starts or stops it with the
    // tabs that show GPU data (Applications and Performance).
    Gpu.GpuSharesPoll(current_tab == TAB_APPLICATIONS || current_tab == TAB_PERFORMANCE)
    if refreshed {
        // NVIDIA cards have no sysfs counters; the helper's whole-card
        // readings stand in for them while it runs.
        if Gpu.GpuSharesReady() {
            readings := Gpu.GpuDevicesCurrent()
            Model.SetExternalGpus(readings.items[0:readings.count])
        } else {
            Model.SetExternalGpus(no_external_gpus[0:0])
        }
        Model.Refresh()
        BuildApps()
        frames_since_refresh = 0
        if now_ms >= 0 { last_refresh_ms = now_ms } else { last_refresh_ms = 0 }
        refresh_requested = false
    }
    if pending_sort || (refreshed && Model.TableRevision() != last_table_revision) {
        BuildOrder()
        last_table_revision = Model.TableRevision()
        pending_sort = false
    }
    if apps_layout_changed && !refreshed {
        BuildApps(false)
    }
    apps_layout_changed = false

    page := PageFor(viewport, 640.0)
    font := FontSize(*page, 14)
    small := FontSize(*page, 13)
    theme := Theme.CurrentTheme()

    Box.Draw(session, Box.Props.{.key = 1, .bounds = viewport, .fill = ColorFromPacked(palette_background)})

    tabs_y := viewport.y + MENU_HEIGHT + 6.0
    TaskTabs(session, .{viewport.x + 8.0, tabs_y, viewport.width - 16.0, TAB_HEIGHT})

    status_y := viewport.y + viewport.height - STATUS_HEIGHT
    panel_y := tabs_y + TAB_HEIGHT
    panel := Rectangle.{viewport.x + 8.0, panel_y, viewport.width - 16.0, status_y - panel_y - 6.0}
    if panel.height < 80.0 { panel.height = 80.0 }
    Box.Draw(session, Box.Props.{.key = 41, .bounds = panel, .fill = ColorFromPacked(PaletteLayer(3)),
        .border = ColorFromPacked(palette_border), .radius = theme.metrics.radius_small})
    content := Inset(panel, PAD)
    ColumnWidths(content.width)
    if current_tab == TAB_APPLICATIONS {
        ApplicationsTab(session, content)
    } else if current_tab == TAB_PERFORMANCE {
        PerformanceTab(session, content, small)
    } else {
        ProcessesTab(session, content)
    }

    // Messages from the last action sit at the panel's bottom left.
    if status_length > 0 {
        status_line: [STATUS_WIDTH]u8
        copy_length := status_length
        if copy_length > STATUS_WIDTH { copy_length = STATUS_WIDTH }
        for copy_index: 0..copy_length - 1 { status_line[copy_index] = status_bytes[copy_index] }
        if current_tab != TAB_PERFORMANCE {
            Label(session, 120, TextView(status_line[0:copy_length]),
                .{content.x, content.y + content.height - BUTTON_HEIGHT + 8.0,
                content.width - BUTTON_WIDTH * 3.0 - 32.0, 18.0}, small)
        }
    }

    StatusBar(session, .{viewport.x, status_y, viewport.width, STATUS_HEIGHT}, small)

    // The menu bar comes last so its open menus draw over the tab content.
    activated := MenuBar(session, .{viewport.x, viewport.y, viewport.width, MENU_HEIGHT})
    if activated > 0 { RunMenu(activated) }

    if dialog == DIALOG_RUN { RunDialog(session, font) }
    if dialog == DIALOG_ABOUT { AboutDialog(session) }
    if dialog == DIALOG_END_PROCESS { EndProcessDialog(session) }
    // Menus and dialogs get first chance to consume the key. With no modal
    // active, Ctrl+1/2/3 follows the visible tab order.
    if dialog == DIALOG_NONE {
        shortcut_tab := Shortcuts.TabForShortcut(KeyboardTake(session),
            KeyboardModifiers(session))
        if shortcut_tab >= 0 { current_tab = shortcut_tab }
    }
    return 0
}
