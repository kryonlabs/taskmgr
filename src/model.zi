// Process and system metrics read from /proc on Linux, plus the ordering and
// formatting helpers the taskmgr interface uses. Refresh keeps one raw
// snapshot plus compact previous PID/tick arrays for CPU deltas, and appends
// each sample to the CPU, kernel CPU and memory histories the Performance
// graphs draw.
using Files :: #import "std/file";
Number :: #import "std/number_text";

libc :: #system_library "libc";
SysConf :: (name: s32) -> s64 #foreign libc "sysconf";
SendSignal :: (pid: s32, signal: s32) -> s32 #foreign libc "kill";
ProcessId :: () -> s32 #foreign libc "getpid";
RunShell :: (command: *u8) -> s32 #foreign libc "system";

CLOCK_TICKS_NAME :: 2; // _SC_CLK_TCK
PAGE_SIZE_NAME :: 30; // _SC_PAGESIZE
STOP_SIGNAL :: 15; // SIGTERM

// Keep the fixed snapshot bounded, but large enough for development hosts and
// servers with several thousand visible processes. A lower cap silently hid
// rows (including taskmgr's own test process) once /proc exceeded 1,024 PIDs.
// Two thousand entries retain that headroom on the development host (which
// runs roughly 1,400 processes) without keeping unused process and UI rows in
// every retained generation.
MAX_PROCESSES :: 2048;
// Linux TASK_COMM_LEN is 16 including the terminator. Keep extra room for
// synthetic group labels without doubling every process snapshot row.
NAME_CAPACITY :: 32;
COLUMNS :: 5;
COMMAND_CAPACITY :: 1024;

// Process table columns, in the classic task manager order.
COLUMN_NAME :: 0;
COLUMN_PID :: 1;
COLUMN_CPU :: 2;
COLUMN_CPU_TIME :: 3;
COLUMN_MEMORY :: 4;

// Samples kept for each Performance graph; one is taken per refresh.
HISTORY_LENGTH :: 60;
HISTORY_CPU :: 0;
HISTORY_KERNEL :: 1;
HISTORY_MEMORY :: 2;
HISTORY_GPU :: 3;
HISTORY_VRAM :: 4;
MAX_GPUS :: 16;
GPU_CARD_LIMIT :: 64;

STATE_RUNNING :: 82; // R
STATE_SLEEPING :: 83; // S
STATE_WAITING :: 68; // D
STATE_STOPPED :: 84; // T
STATE_ZOMBIE :: 90; // Z
STATE_IDLE :: 73; // I

Process :: struct {
    pid: s32
    name_count: s32
    name: [NAME_CAPACITY]u8
    state: u8
    // Parent PID from /proc/<pid>/stat field 4; it sits in the padding before
    // cpu_percent, so the snapshot row does not grow.
    ppid: s32
    cpu_percent: float64
    memory_bytes: u64
    ticks: u64
    threads: s32
    // One for a raw process; more than one for an aggregated process group.
    group_count: s32
}

GroupEndResult :: struct {
    requested: s32
    sent: s32
    failed: s32
}

// Memory figures from /proc/meminfo, in kilobytes as the kernel reports them.
// Commit charge is Committed_AS against CommitLimit; kernel memory is the slab
// allocator, split into reclaimable (paged) and unreclaimable (nonpaged).
MemoryDetails :: struct {
    total_kb: s64
    available_kb: s64
    cache_kb: s64
    commit_kb: s64
    commit_limit_kb: s64
    kernel_paged_kb: s64
    kernel_nonpaged_kb: s64
    swap_total_kb: s64
    swap_free_kb: s64
}

// One stable DRM card. card_index comes from cardN, so labels and histories do
// not change when directory enumeration order does. Unsupported counters stay
// explicit instead of looking like 0% or 100% usage.
GpuDevice :: struct {
    card_index: s32
    busy_supported: bool
    busy_percent: float64
    vram_supported: bool
    vram_used: u64
    vram_total: u64
}

Snapshot :: struct {
    processes: [MAX_PROCESSES]Process
    count: s32
    cpu_percent: float64
    kernel_percent: float64
    memory_used: u64
    memory_total: u64
    busy_ticks: u64
    kernel_ticks: u64
    total_ticks: u64
    threads: s64
    // Allocated file handles from /proc/sys/fs/file-nr, or -1.
    handles: s64
    memory: MemoryDetails
    gpu_percent: float64
    gpus: [MAX_GPUS]GpuDevice
    gpu_count: s32
    gpu_supported_count: s32
    vram_used: u64
    vram_total: u64
}

// Group rows retain only the representative raw-process index and the values
// that are actually aggregated for the process table. Keeping a third full
// Snapshot duplicated every process name, state and GPU/system field.
ProcessGroup :: struct {
    process_index: s32
    group_count: s32
    cpu_percent: float64
    memory_bytes: u64
    ticks: u64
}

GroupedSnapshot :: struct {
    groups: [MAX_PROCESSES]ProcessGroup
    count: s32
}

state_names: [7]string = .{"Running", "Sleeping", "Waiting", "Stopped", "Zombie", "Idle", "Other"};

snapshot: Snapshot;
// Only PID/ticks plus the three system counters are needed from the preceding
// sample to calculate CPU deltas. This replaces a second full raw snapshot.
previous_pids: [MAX_PROCESSES]s32;
previous_process_ticks: [MAX_PROCESSES]u64;
previous_count: s32;
previous_busy_ticks: u64;
previous_kernel_ticks: u64;
previous_total_ticks: u64;
// The highest commit charge seen while taskmgr runs.
commit_peak_kb: s64;

// Ring buffers of percentages; history_next is the slot the next sample takes.
cpu_history: [HISTORY_LENGTH]float32;
kernel_history: [HISTORY_LENGTH]float32;
memory_history: [HISTORY_LENGTH]float32;
gpu_history: [HISTORY_LENGTH]float32;
vram_history: [HISTORY_LENGTH]float32;
gpu_device_history: [GPU_CARD_LIMIT * HISTORY_LENGTH]float32;
vram_device_history: [GPU_CARD_LIMIT * HISTORY_LENGTH]float32;
history_next: s32;
history_count: s32;
clock_ticks: float64;
page_bytes: u64;
timing_ready: bool;
grouped_snapshot: GroupedSnapshot;

#program_export
Current :: () -> *Snapshot {
    return *snapshot
}

#program_export
GroupedCurrent :: () -> *GroupedSnapshot {
    return *grouped_snapshot
}

#program_export
CurrentProcessId :: () -> s32 {
    return ProcessId()
}

EnsureTiming :: () {
    if timing_ready { return }
    ticks := SysConf(CLOCK_TICKS_NAME)
    pages := SysConf(PAGE_SIZE_NAME)
    if ticks > 0 { clock_ticks = cast(float64)ticks } else { clock_ticks = 100.0 }
    if pages > 0 { page_bytes = cast(u64)pages } else { page_bytes = 4096 }
    timing_ready = true
}

#program_export
StateName :: (state: u8) -> string {
    if state == STATE_RUNNING { return state_names[0] }
    if state == STATE_SLEEPING { return state_names[1] }
    if state == STATE_WAITING { return state_names[2] }
    if state == STATE_STOPPED { return state_names[3] }
    if state == STATE_ZOMBIE { return state_names[4] }
    if state == STATE_IDLE { return state_names[5] }
    return state_names[6]
}

// Reads a small file, such as a /proc entry, fully into a caller-owned buffer.
// Returns the byte count, or -1 when the path cannot be opened.
ReadSmall :: (path: string, buffer: []u8) -> s32 {
    file := Files.OpenRead(path)
    if !file.valid { return -1 }
    total: s32 = 0
    while total < cast(s32)buffer.count {
        count := Files.ReadAt(file, buffer[total:buffer.count], cast(s64)total)
        if count <= 0 { break }
        total += cast(s32)count
    }
    Files.CloseFile(file)
    return total
}

StatPath :: (pid: s32, output: []u8) -> string {
    digits: [16]u8
    pieces: [3]string = .{"/proc/", Number.FormatInteger(cast(s64)pid, digits[:]), "/stat"}
    length: s32 = 0
    for piece: pieces {
        for byte: piece {
            if length >= cast(s32)output.count { break }
            output[length] = byte
            length += 1
        }
    }
    return TextView(output[0:length])
}

ParsePidName :: (name_bytes: []u8) -> s32 {
    if name_bytes.count == 0 { return -1 }
    value: s64 = 0
    for byte: name_bytes {
        if byte < 48 || byte > 57 { return -1 }
        value = value * 10 + cast(s64)(byte - 48)
        if value > 2147483647 { return -1 }
    }
    return cast(s32)value
}

// Parses /proc/<pid>/stat: the command name sits between the first '(' and the
// last ')'; after it come the state and the numbered fields, where ppid is
// field 4, utime is field 14, stime is field 15, num_threads is field 20, and rss is field 24.
#program_export
ParseStat :: (content: []u8, process: *Process) -> bool {
    EnsureTiming()
    open: s32 = -1
    close: s32 = -1
    total := cast(s32)content.count
    for index: 0..total - 1 {
        if content[index] == 40 && open < 0 { open = index }
        if content[index] == 41 { close = index }
    }
    if open < 0 || close <= open { return false }
    name_length := close - open - 1
    if name_length > NAME_CAPACITY { name_length = NAME_CAPACITY }
    for index: 0..name_length - 1 {
        process.name[index] = content[open + 1 + index]
    }
    process.name_count = name_length
    cursor := close + 1
    while cursor < total && content[cursor] == 32 { cursor += 1 }
    if cursor >= total { return false }
    process.state = content[cursor]
    cursor += 1
    utime: u64 = 0
    stime: u64 = 0
    rss: u64 = 0
    field: s32 = 4
    while field <= 24 && cursor < total {
        while cursor < total && content[cursor] == 32 { cursor += 1 }
        negative := false
        if cursor < total && content[cursor] == 45 {
            negative = true
            cursor += 1
        }
        value: u64 = 0
        digits: s32 = 0
        while cursor < total && content[cursor] >= 48 && content[cursor] <= 57 {
            value = value * 10 + cast(u64)(content[cursor] - 48)
            cursor += 1
            digits += 1
        }
        if digits == 0 { return false }
        if !negative && field == 4 { process.ppid = cast(s32)value }
        if !negative && field == 14 { utime = value }
        if !negative && field == 15 { stime = value }
        if !negative && field == 20 { process.threads = cast(s32)value }
        if !negative && field == 24 { rss = value }
        field += 1
    }
    if field <= 24 { return false }
    process.ticks = utime + stime
    process.memory_bytes = rss * page_bytes
    return true
}

// Sums /proc/stat's CPU values; busy excludes idle and iowait. Linux's guest
// columns duplicate time already included in user and nice, so totals include
// only the first eight columns.
#program_export
CpuTotals :: (content: []u8) -> (busy: u64, total: u64, ok: bool) {
    cursor: s32 = 0
    total_count := cast(s32)content.count
    while cursor < total_count && content[cursor] != 32 { cursor += 1 }
    values: [10]u64
    count: s32 = 0
    while count < 10 && cursor < total_count {
        while cursor < total_count && content[cursor] == 32 { cursor += 1 }
        if cursor >= total_count || content[cursor] == 10 { break }
        value: u64 = 0
        while cursor < total_count && content[cursor] >= 48 && content[cursor] <= 57 {
            value = value * 10 + cast(u64)(content[cursor] - 48)
            cursor += 1
        }
        values[count] = value
        count += 1
    }
    if count < 4 { return 0, 0, false }
    total_value: u64 = 0
    idle_value: u64 = 0
    included := count
    if included > 8 { included = 8 }
    for index: 0..included - 1 {
        total_value += values[index]
        if index == 3 || index == 4 { idle_value += values[index] }
    }
    return total_value - idle_value, total_value, true
}

// The kernel's share of /proc/stat's CPU time: system, irq and softirq, the
// third, sixth and seventh values. Returns 0 when the line is too short.
#program_export
CpuKernelTicks :: (content: []u8) -> u64 {
    cursor: s32 = 0
    total_count := cast(s32)content.count
    while cursor < total_count && content[cursor] != 32 { cursor += 1 }
    kernel: u64 = 0
    count: s32 = 0
    while count < 7 && cursor < total_count {
        while cursor < total_count && content[cursor] == 32 { cursor += 1 }
        if cursor >= total_count || content[cursor] == 10 { break }
        value: u64 = 0
        while cursor < total_count && content[cursor] >= 48 && content[cursor] <= 57 {
            value = value * 10 + cast(u64)(content[cursor] - 48)
            cursor += 1
        }
        if count == 2 || count == 5 || count == 6 { kernel += value }
        count += 1
    }
    if count < 7 { return 0 }
    return kernel
}

// The first decimal number in content, such as /proc/sys/fs/file-nr's count of
// allocated file handles; -1 when there is none.
#program_export
FirstNumber :: (content: []u8) -> s64 {
    cursor: s32 = 0
    total_count := cast(s32)content.count
    while cursor < total_count && (content[cursor] < 48 || content[cursor] > 57) { cursor += 1 }
    if cursor >= total_count { return -1 }
    value: s64 = 0
    while cursor < total_count && content[cursor] >= 48 && content[cursor] <= 57 {
        value = value * 10 + cast(s64)(content[cursor] - 48)
        cursor += 1
    }
    return value
}

IsDrmCardName :: (name: []u8) -> bool {
    if name.count <= 4 || name[0] != 99 || name[1] != 97 ||
       name[2] != 114 || name[3] != 100 { return false }
    for index: 4..cast(s32)name.count - 1 {
        if name[index] < 48 || name[index] > 57 { return false }
    }
    return true
}

DrmCardIndex :: (name: []u8) -> s32 {
    if !IsDrmCardName(name) { return -1 }
    value: s32 = 0
    for index: 4..cast(s32)name.count - 1 {
        digit := cast(s32)(name[index] - 48)
        if value > (GPU_CARD_LIMIT - 1 - digit) / 10 { return -1 }
        value = value * 10 + digit
    }
    if value >= GPU_CARD_LIMIT { return -1 }
    return value
}

DrmPath :: (card: []u8, leaf: string, output: []u8) -> string {
    length := Append(output, 0, "/sys/class/drm/")
    for byte: card {
        if length >= cast(s32)output.count { break }
        output[length] = byte
        length += 1
    }
    length = Append(output, length, "/device/")
    length = Append(output, length, leaf)
    return TextView(output[0:length])
}

// A whole-card reading from outside sysfs (NVIDIA's NVML, through the GPU
// helper), matched to a DRM card by PCI address because NVIDIA's driver
// publishes no gpu_busy_percent or mem_info_vram_* files. A negative busy or
// a non-positive vram_total marks that counter unsupported.
GpuExternal :: struct {
    domain: u32
    bus: u32
    slot: u32
    busy: s64
    vram_used: s64
    vram_total: s64
}

external_gpus: [MAX_GPUS]GpuExternal;
external_gpu_count: s32;

// Replaces the outside readings the next Refresh may use; an empty slice
// removes them, so a stopped source never leaves stale values behind.
#program_export
SetExternalGpus :: (readings: []GpuExternal) {
    external_gpu_count = 0
    for reading: readings {
        if external_gpu_count >= MAX_GPUS { break }
        external_gpus[external_gpu_count] = reading
        external_gpu_count += 1
    }
}

#program_export
ExternalGpuFor :: (domain: u32, bus: u32, slot: u32) -> s32 {
    if external_gpu_count <= 0 { return -1 }
    for index: 0..external_gpu_count - 1 {
        reading := *external_gpus[index]
        if reading.domain == domain && reading.bus == bus && reading.slot == slot { return index }
    }
    return -1
}

HexDigit :: (byte: u8) -> s32 {
    if byte >= 48 && byte <= 57 { return cast(s32)(byte - 48) }
    if byte >= 97 && byte <= 102 { return cast(s32)(byte - 87) }
    if byte >= 65 && byte <= 70 { return cast(s32)(byte - 55) }
    return -1
}

// Parses one hexadecimal field of a PCI address and the separator after it.
HexField :: (text: []u8, start: s32, separator: u8) -> (value: u32, next: s32, ok: bool) {
    cursor := start
    value: u32 = 0
    total := cast(s32)text.count
    while cursor < total && cursor - start < 8 {
        digit := HexDigit(text[cursor])
        if digit < 0 { break }
        value = value * 16 + cast(u32)digit
        cursor += 1
    }
    if cursor == start { return 0, cursor, false }
    if separator != 0 {
        if cursor >= total || text[cursor] != separator { return 0, cursor, false }
        cursor += 1
    }
    return value, cursor, true
}

// Reads PCI_SLOT_NAME=dddd:bb:ss.f from a sysfs uevent file.
#program_export
PciSlotFromUevent :: (content: []u8) -> (domain: u32, bus: u32, slot: u32, function: u32, ok: bool) {
    label := "PCI_SLOT_NAME="
    limit := cast(s32)content.count
    label_count := cast(s32)label.count
    index: s32 = 0
    while index < limit {
        if index > 0 && content[index - 1] != 10 {
            index += 1
            continue
        }
        matched := true
        offset: s32 = 0
        while offset < label_count {
            if index + offset >= limit || content[index + offset] != label[offset] {
                matched = false
                break
            }
            offset += 1
        }
        if matched {
            domain, after_domain, domain_ok := HexField(content, index + offset, 58)
            bus, after_bus, bus_ok := HexField(content, after_domain, 58)
            slot, after_slot, slot_ok := HexField(content, after_bus, 46)
            function, after_function, function_ok := HexField(content, after_slot, 0)
            if domain_ok && bus_ok && slot_ok && function_ok {
                return domain, bus, slot, function, true
            }
            return 0, 0, 0, 0, false
        }
        index += 1
    }
    return 0, 0, 0, 0, false
}

// Adds one card's independent sysfs buffers, keeping card order stable. A zero
// used counter is valid. Missing totals and inconsistent used > total pairs are
// unsupported, never interpreted as fully used.
#program_export
AddGpuCounters :: (snapshot: *Snapshot, card_index: s32,
    busy_text: []u8, used_text: []u8, total_text: []u8) {
    AddGpuValues(snapshot, card_index, FirstNumber(busy_text), FirstNumber(used_text),
        FirstNumber(total_text))
}

// The numeric form of AddGpuCounters; negative values are missing counters.
#program_export
AddGpuValues :: (snapshot: *Snapshot, card_index: s32, busy: s64, used: s64, total: s64) {
    if card_index < 0 || card_index >= GPU_CARD_LIMIT || snapshot.gpu_count >= MAX_GPUS { return }
    device: GpuDevice
    device.card_index = card_index
    if busy >= 0 {
        if busy > 100 { busy = 100 }
        device.busy_supported = true
        device.busy_percent = cast(float64)busy
        snapshot.gpu_percent += device.busy_percent
        snapshot.gpu_supported_count += 1
    }
    if used >= 0 && total > 0 && used <= total {
        device.vram_supported = true
        device.vram_used = cast(u64)used
        device.vram_total = cast(u64)total
        snapshot.vram_used += device.vram_used
        snapshot.vram_total += device.vram_total
    }
    position := snapshot.gpu_count
    while position > 0 && snapshot.gpus[position - 1].card_index > card_index {
        snapshot.gpus[position] = snapshot.gpus[position - 1]
        position -= 1
    }
    snapshot.gpus[position] = device
    snapshot.gpu_count += 1
}

#program_export
FinalizeGpuStats :: (snapshot: *Snapshot) {
    if snapshot.gpu_supported_count > 0 {
        snapshot.gpu_percent /= cast(float64)snapshot.gpu_supported_count
    } else {
        snapshot.gpu_percent = 0
    }
}

#program_export
GpuVramPercent :: (device: *GpuDevice) -> float64 {
    if !device.vram_supported || device.vram_total == 0 || device.vram_used > device.vram_total {
        return -1.0
    }
    return 100.0 * cast(float64)device.vram_used / cast(float64)device.vram_total
}

// Samples every DRM card that exposes standard Linux sysfs counters. Each
// counter has its own buffer: reading total must not overwrite used before it
// is parsed (the previous alias made every adapter appear 100% full). A card
// with none of those files (NVIDIA's driver) uses the external reading for
// its PCI address when one was set.
ReadGpuStats :: (snapshot: *Snapshot) {
    directory := Files.OpenDirectory("/sys/class/drm")
    busy_buffer: [128]u8
    used_buffer: [128]u8
    total_buffer: [128]u8
    uevent_buffer: [512]u8
    path: [160]u8
    while true {
        entry := Files.NextDirectoryEntry(*directory)
        if !entry.valid { break }
        card := entry.name[0:entry.name_count]
        card_index := DrmCardIndex(card)
        if card_index < 0 { continue }
        busy_length := ReadSmall(DrmPath(card, "gpu_busy_percent", path[:]), busy_buffer[:])
        used_length := ReadSmall(DrmPath(card, "mem_info_vram_used", path[:]), used_buffer[:])
        total_length := ReadSmall(DrmPath(card, "mem_info_vram_total", path[:]), total_buffer[:])
        if busy_length <= 0 && used_length <= 0 && total_length <= 0 && external_gpu_count > 0 {
            uevent_length := ReadSmall(DrmPath(card, "uevent", path[:]), uevent_buffer[:])
            if uevent_length > 0 {
                domain, bus, slot, function, ok := PciSlotFromUevent(uevent_buffer[0:uevent_length])
                external := -1
                if ok && function == 0 { external = ExternalGpuFor(domain, bus, slot) }
                if external >= 0 {
                    reading := *external_gpus[external]
                    AddGpuValues(snapshot, card_index, reading.busy, reading.vram_used,
                        reading.vram_total)
                    continue
                }
            }
        }
        busy_text: []u8 = busy_buffer[0:0]
        used_text: []u8 = used_buffer[0:0]
        total_text: []u8 = total_buffer[0:0]
        if busy_length > 0 { busy_text = busy_buffer[0:busy_length] }
        if used_length > 0 { used_text = used_buffer[0:used_length] }
        if total_length > 0 { total_text = total_buffer[0:total_length] }
        AddGpuCounters(snapshot, card_index, busy_text, used_text, total_text)
    }
    Files.CloseDirectory(*directory)
    FinalizeGpuStats(snapshot)
}

LowerByte :: (byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 { return byte + cast(u8)32 }
    return byte
}

#program_export
IsCodexProcessName :: (name: []u8) -> bool {
    if name.count < 5 { return false }
    target: [5]u8 = .[99, 111, 100, 101, 120]
    for index: 0..4 {
        if LowerByte(name[index]) != target[index] { return false }
    }
    return true
}

#program_export
SameProcessGroup :: (left: *Process, right: *Process) -> bool {
    left_name := left.name[0:left.name_count]
    right_name := right.name[0:right.name_count]
    if IsCodexProcessName(left_name) && IsCodexProcessName(right_name) { return true }
    if left.name_count != right.name_count { return false }
    if left.name_count > 0 {
        for index: 0..left.name_count - 1 {
            if LowerByte(left.name[index]) != LowerByte(right.name[index]) { return false }
        }
    }
    return true
}

// Aggregates processes with the same image name without copying every Process
// field into a third full snapshot.
#program_export
BuildGroupedSnapshot :: (source: *Snapshot, target: *GroupedSnapshot) {
    target.count = 0
    if source.count <= 0 { return }
    for index: 0..source.count - 1 {
        entry := *source.processes[index]
        group: s32 = -1
        if target.count > 0 {
            for candidate: 0..target.count - 1 {
                representative := target.groups[candidate].process_index
                if representative >= 0 && representative < source.count &&
                   SameProcessGroup(*source.processes[representative], entry) {
                    group = candidate
                    break
                }
            }
        }
        if group < 0 {
            group = target.count
            target.groups[group].process_index = index
            target.groups[group].group_count = 1
            target.groups[group].cpu_percent = entry.cpu_percent
            target.groups[group].memory_bytes = entry.memory_bytes
            target.groups[group].ticks = entry.ticks
            target.count += 1
        } else {
            target.groups[group].cpu_percent += entry.cpu_percent
            target.groups[group].memory_bytes += entry.memory_bytes
            target.groups[group].ticks += entry.ticks
            target.groups[group].group_count += 1
        }
    }
}

// Materializes one compact group as a Process only for the caller's immediate
// formatting or comparison. Codex-family aliases keep their canonical label.
#program_export
GroupProcess :: (source: *Snapshot, group: *ProcessGroup) -> Process {
    result: Process
    if group.process_index < 0 || group.process_index >= source.count { return result }
    result = source.processes[group.process_index]
    result.cpu_percent = group.cpu_percent
    result.memory_bytes = group.memory_bytes
    result.ticks = group.ticks
    result.group_count = group.group_count
    if IsCodexProcessName(result.name[0:result.name_count]) {
        result.name_count = 5
        result.name[0] = 99
        result.name[1] = 111
        result.name[2] = 100
        result.name[3] = 101
        result.name[4] = 120
    }
    return result
}

// Reads the memory figures the Performance tab shows from /proc/meminfo text.
#program_export
ParseMemory :: (content: []u8) -> MemoryDetails {
    details: MemoryDetails
    details.total_kb = LineKb(content, "MemTotal:")
    details.available_kb = LineKb(content, "MemAvailable:")
    if details.available_kb < 0 { details.available_kb = LineKb(content, "MemFree:") }
    cached := LineKb(content, "Cached:")
    buffers := LineKb(content, "Buffers:")
    details.cache_kb = -1
    if cached >= 0 {
        details.cache_kb = cached
        if buffers > 0 { details.cache_kb += buffers }
    }
    details.commit_kb = LineKb(content, "Committed_AS:")
    details.commit_limit_kb = LineKb(content, "CommitLimit:")
    details.kernel_paged_kb = LineKb(content, "SReclaimable:")
    details.kernel_nonpaged_kb = LineKb(content, "SUnreclaim:")
    details.swap_total_kb = LineKb(content, "SwapTotal:")
    details.swap_free_kb = LineKb(content, "SwapFree:")
    return details
}

// Reads the kilobyte value of a /proc/meminfo entry, such as "MemTotal:". The
// label must start a line, so "Cached:" never matches "SwapCached:".
LineKb :: (content: []u8, label: string) -> s64 {
    limit := cast(s32)content.count
    label_count := cast(s32)label.count
    index: s32 = 0
    while index < limit {
        if index > 0 && content[index - 1] != 10 {
            index += 1
            continue
        }
        matched := true
        offset: s32 = 0
        while offset < label_count {
            if index + offset >= limit || content[index + offset] != label[offset] {
                matched = false
                break
            }
            offset += 1
        }
        if matched {
            cursor := index + offset
            while cursor < limit && content[cursor] == 32 { cursor += 1 }
            value: s64 = 0
            while cursor < limit && content[cursor] >= 48 && content[cursor] <= 57 {
                value = value * 10 + cast(s64)(content[cursor] - 48)
                cursor += 1
            }
            return value
        }
        index += 1
    }
    return -1
}

FindPreviousTicks :: (pid: s32) -> (found: bool, ticks: u64) {
    if previous_count > 0 {
        for index: 0..previous_count - 1 {
            if previous_pids[index] == pid {
                return true, previous_process_ticks[index]
            }
        }
    }
    return false, 0
}

#program_export
FindProcess :: (snapshot: *Snapshot, pid: s32) -> s32 {
    if snapshot.count > 0 {
        for index: 0..snapshot.count - 1 {
            if snapshot.processes[index].pid == pid { return index }
        }
    }
    return -1
}

// Resource use behind one Applications row: the window's own process plus
// every descendant that no nearer listed window owns. found is false when the
// window publishes no PID or that PID is not in the snapshot.
AppUsage :: struct {
    found: bool
    gpu_known: bool
    processes: s32
    cpu_percent: float64
    memory_bytes: u64
    gpu_percent: float64
}

// Deep enough for shells, launchers and browser helpers; also stops a
// corrupted parent chain from looping.
MAX_TREE_DEPTH :: 64;

// Snapshot indices ordered by PID, and the window slot each process directly
// represents (-1 for none). Rebuilt by AppUsages; never retained across calls.
pid_order: [MAX_PROCESSES]s32;
owner_slot: [MAX_PROCESSES]s32;

// /proc lists PIDs in ascending order, so this insertion sort is linear in
// practice and still correct when the order differs.
BuildPidOrder :: (snapshot: *Snapshot) {
    count := snapshot.count
    if count <= 0 { return }
    for slot: 0..count - 1 {
        key := slot
        key_pid := snapshot.processes[key].pid
        position := slot - 1
        while position >= 0 && snapshot.processes[pid_order[position]].pid > key_pid {
            pid_order[position + 1] = pid_order[position]
            position -= 1
        }
        pid_order[position + 1] = key
    }
}

IndexOfPid :: (snapshot: *Snapshot, pid: s32) -> s32 {
    low: s32 = 0
    high := snapshot.count - 1
    while low <= high {
        middle := low + (high - low) / 2
        index := pid_order[middle]
        value := snapshot.processes[index].pid
        if value == pid { return index }
        if value < pid { low = middle + 1 } else { high = middle - 1 }
    }
    return -1
}

// Sums CPU share, resident memory and GPU share per window. Each process
// counts once, toward the nearest ancestor (itself included) whose PID owns a
// listed window, so a browser started from a terminal is the browser's, not
// the terminal's. Windows that share a PID show the same totals. GPU_PIDS and
// GPU_PERCENT are per-process GPU shares; GPU_KNOWN false means no per-process
// GPU source exists and every gpu_known stays false.
#program_export
AppUsages :: (snapshot: *Snapshot, window_pids: []s32, gpu_pids: []s32,
    gpu_percent: []float64, gpu_known: bool, output: []AppUsage) {
    count := cast(s32)window_pids.count
    if count > cast(s32)output.count { count = cast(s32)output.count }
    if count <= 0 { return }
    for slot: 0..count - 1 {
        output[slot] = AppUsage.{}
        output[slot].gpu_known = gpu_known
    }
    if snapshot.count <= 0 { return }
    BuildPidOrder(snapshot)
    for index: 0..snapshot.count - 1 { owner_slot[index] = -1 }
    for slot: 0..count - 1 {
        pid := window_pids[slot]
        if pid <= 0 { continue }
        index := IndexOfPid(snapshot, pid)
        if index >= 0 && owner_slot[index] < 0 { owner_slot[index] = slot }
    }
    gpu_count := cast(s32)gpu_pids.count
    if gpu_count > cast(s32)gpu_percent.count { gpu_count = cast(s32)gpu_percent.count }
    for index: 0..snapshot.count - 1 {
        cursor := index
        slot: s32 = -1
        depth: s32 = 0
        while cursor >= 0 && depth < MAX_TREE_DEPTH {
            if owner_slot[cursor] >= 0 {
                slot = owner_slot[cursor]
                break
            }
            parent := snapshot.processes[cursor].ppid
            if parent <= 0 { break }
            cursor = IndexOfPid(snapshot, parent)
            depth += 1
        }
        if slot < 0 { continue }
        process := *snapshot.processes[index]
        usage := *output[slot]
        usage.found = true
        usage.processes += 1
        usage.cpu_percent += process.cpu_percent
        usage.memory_bytes += process.memory_bytes
        if gpu_known && gpu_count > 0 {
            for entry: 0..gpu_count - 1 {
                if gpu_pids[entry] == process.pid { usage.gpu_percent += gpu_percent[entry] }
            }
        }
    }
    // A second window of the same process repeats the first one's totals.
    for slot: 0..count - 1 {
        pid := window_pids[slot]
        if pid <= 0 { continue }
        index := IndexOfPid(snapshot, pid)
        if index < 0 { continue }
        first := owner_slot[index]
        if first >= 0 && first != slot { output[slot] = output[first] }
    }
}

// Samples /proc into the live snapshot. CPU percentages use compact PID/tick
// arrays and system counters retained from the previous sample.
#program_export
Refresh :: () {
    EnsureTiming()
    previous_count = snapshot.count
    if previous_count > 0 {
        for index: 0..previous_count - 1 {
            previous_pids[index] = snapshot.processes[index].pid
            previous_process_ticks[index] = snapshot.processes[index].ticks
        }
    }
    previous_busy_ticks = snapshot.busy_ticks
    previous_kernel_ticks = snapshot.kernel_ticks
    previous_total_ticks = snapshot.total_ticks
    target := *snapshot
    target.count = 0
    target.cpu_percent = 0
    target.kernel_percent = 0
    target.memory_used = 0
    target.memory_total = 0
    target.busy_ticks = 0
    target.kernel_ticks = 0
    target.total_ticks = 0
    target.threads = 0
    target.handles = -1
    target.memory = MemoryDetails.{}
    target.gpu_percent = 0
    target.gpu_count = 0
    target.gpu_supported_count = 0
    target.vram_used = 0
    target.vram_total = 0

    stat_buffer: [8192]u8
    busy: u64 = 0
    kernel_ticks: u64 = 0
    total_ticks: u64 = 0
    stat_length := ReadSmall("/proc/stat", stat_buffer[:])
    if stat_length > 0 {
        sample_busy, sample_total, ok := CpuTotals(stat_buffer[0:stat_length])
        if ok {
            busy = sample_busy
            total_ticks = sample_total
            kernel_ticks = CpuKernelTicks(stat_buffer[0:stat_length])
        }
    }
    mem_length := ReadSmall("/proc/meminfo", stat_buffer[:])
    if mem_length > 0 {
        target.memory = ParseMemory(stat_buffer[0:mem_length])
        total_kb := target.memory.total_kb
        available_kb := target.memory.available_kb
        if total_kb > 0 {
            target.memory_total = cast(u64)total_kb * 1024
            if available_kb >= 0 && available_kb <= total_kb {
                target.memory_used = (cast(u64)total_kb - cast(u64)available_kb) * 1024
            } else {
                target.memory_used = target.memory_total
            }
        }
        if target.memory.commit_kb > commit_peak_kb { commit_peak_kb = target.memory.commit_kb }
    }
    handles_length := ReadSmall("/proc/sys/fs/file-nr", stat_buffer[:])
    if handles_length > 0 { target.handles = FirstNumber(stat_buffer[0:handles_length]) }
    ReadGpuStats(target)

    directory := Files.OpenDirectory("/proc")
    path_buffer: [64]u8
    while true {
        entry := Files.NextDirectoryEntry(*directory)
        if !entry.valid { break }
        if target.count >= MAX_PROCESSES { break }
        pid := ParsePidName(entry.name[0:entry.name_count])
        if pid <= 0 { continue }
        stat_entry := StatPath(pid, path_buffer[:])
        length := ReadSmall(stat_entry, stat_buffer[:])
        if length <= 0 { continue }
        process: Process
        process.pid = pid
        if !ParseStat(stat_buffer[0:length], *process) { continue }
        process.cpu_percent = 0
        process.group_count = 1
        found, previous_ticks := FindPreviousTicks(pid)
        if found && process.ticks >= previous_ticks && total_ticks > previous_total_ticks {
            delta := cast(float64)(process.ticks - previous_ticks)
            span := cast(float64)(total_ticks - previous_total_ticks)
            process.cpu_percent = 100.0 * delta / span
        }
        target.processes[target.count] = process
        target.count += 1
        if process.threads > 0 { target.threads += cast(s64)process.threads }
    }
    Files.CloseDirectory(*directory)

    target.busy_ticks = busy
    target.kernel_ticks = kernel_ticks
    target.total_ticks = total_ticks
    if previous_total_ticks > 0 && total_ticks > previous_total_ticks && busy >= previous_busy_ticks {
        delta_busy := cast(float64)(busy - previous_busy_ticks)
        span := cast(float64)(total_ticks - previous_total_ticks)
        target.cpu_percent = 100.0 * delta_busy / span
        if kernel_ticks >= previous_kernel_ticks {
            target.kernel_percent = 100.0 * cast(float64)(kernel_ticks - previous_kernel_ticks) / span
        }
    }
    BuildGroupedSnapshot(target, *grouped_snapshot)
    // The first sample has no previous one to measure CPU time against.
    if previous_total_ticks > 0 {
        memory_percent: float64 = 0
        if target.memory_total > 0 {
            memory_percent = 100.0 * cast(float64)target.memory_used / cast(float64)target.memory_total
        }
        vram_percent: float64 = 0
        if target.vram_total > 0 {
            vram_percent = 100.0 * cast(float64)target.vram_used / cast(float64)target.vram_total
        }
        PushGpuDeviceHistories(target)
        PushHistoryExtended(target.cpu_percent, target.kernel_percent, memory_percent,
            target.gpu_percent, vram_percent)
    }
}

ClampPercent :: (value: float64) -> float32 {
    if value < 0.0 { return 0.0 }
    if value > 100.0 { return 100.0 }
    return cast(float32)value
}

// Device history uses the same ring slot as the aggregate histories. Missing
// counters write zero but remain explicitly unsupported in the live snapshot,
// so the UI can omit their series and label them n/a.
#program_export
PushGpuDeviceHistories :: (snapshot: *Snapshot) {
    for card: 0..GPU_CARD_LIMIT - 1 {
        offset := card * HISTORY_LENGTH + history_next
        gpu_device_history[offset] = 0.0
        vram_device_history[offset] = 0.0
    }
    if snapshot.gpu_count <= 0 { return }
    for index: 0..snapshot.gpu_count - 1 {
        device := *snapshot.gpus[index]
        if device.card_index < 0 || device.card_index >= GPU_CARD_LIMIT { continue }
        offset := device.card_index * HISTORY_LENGTH + history_next
        if device.busy_supported {
            gpu_device_history[offset] = ClampPercent(device.busy_percent)
        }
        vram := GpuVramPercent(device)
        if vram >= 0.0 { vram_device_history[offset] = ClampPercent(vram) }
    }
}

#program_export
PushHistory :: (cpu: float64, kernel: float64, memory: float64) {
    PushHistoryExtended(cpu, kernel, memory, 0.0, 0.0)
}

#program_export
PushHistoryExtended :: (cpu: float64, kernel: float64, memory: float64,
    gpu: float64, vram: float64) {
    cpu_history[history_next] = ClampPercent(cpu)
    kernel_history[history_next] = ClampPercent(kernel)
    memory_history[history_next] = ClampPercent(memory)
    gpu_history[history_next] = ClampPercent(gpu)
    vram_history[history_next] = ClampPercent(vram)
    history_next = (history_next + 1) % HISTORY_LENGTH
    if history_count < HISTORY_LENGTH { history_count += 1 }
}

// Copies one history, oldest first, into the last slots of OUTPUT and zeros
// the slots before it, so a graph scrolls in from the right edge at a fixed
// time scale. Returns the filled slice, at most HISTORY_LENGTH long.
#program_export
History :: (kind: s32, output: []float32) -> []float32 {
    length: s32 = HISTORY_LENGTH
    if length > cast(s32)output.count { length = cast(s32)output.count }
    if length <= 0 { return output[0:0] }
    for index: 0..length - 1 { output[index] = 0.0 }
    shown := history_count
    if shown > length { shown = length }
    if shown > 0 {
        for step: 0..shown - 1 {
            slot := (history_next - shown + step + HISTORY_LENGTH) % HISTORY_LENGTH
            value: float32 = cpu_history[slot]
            if kind == HISTORY_KERNEL { value = kernel_history[slot] }
            if kind == HISTORY_MEMORY { value = memory_history[slot] }
            if kind == HISTORY_GPU { value = gpu_history[slot] }
            if kind == HISTORY_VRAM { value = vram_history[slot] }
            output[length - shown + step] = value
        }
    }
    return output[0:length]
}

// Copies one stable card's GPU or VRAM history, oldest first.
#program_export
GpuHistory :: (kind: s32, card_index: s32, output: []float32) -> []float32 {
    length: s32 = HISTORY_LENGTH
    if length > cast(s32)output.count { length = cast(s32)output.count }
    if length <= 0 || card_index < 0 || card_index >= GPU_CARD_LIMIT { return output[0:0] }
    for index: 0..length - 1 { output[index] = 0.0 }
    shown := history_count
    if shown > length { shown = length }
    if shown > 0 {
        for step: 0..shown - 1 {
            slot := (history_next - shown + step + HISTORY_LENGTH) % HISTORY_LENGTH
            offset := card_index * HISTORY_LENGTH + slot
            value := gpu_device_history[offset]
            if kind == HISTORY_VRAM { value = vram_device_history[offset] }
            output[length - shown + step] = value
        }
    }
    return output[0:length]
}

// Clock ticks per second, as /proc reports CPU time.
#program_export
ClockTicks :: () -> float64 {
    EnsureTiming()
    return clock_ticks
}

#program_export
CommitPeakKb :: () -> s64 {
    return commit_peak_kb
}

CompareName :: (left: []u8, right: []u8) -> s32 {
    index: s32 = 0
    while index < cast(s32)left.count && index < cast(s32)right.count {
        if left[index] < right[index] { return -1 }
        if left[index] > right[index] { return 1 }
        index += 1
    }
    if left.count < right.count { return -1 }
    if left.count > right.count { return 1 }
    return 0
}

CompareProcesses :: (left: *Process, right: *Process, column: s32) -> s32 {
    if column == COLUMN_NAME {
        return CompareName(left.name[0:left.name_count], right.name[0:right.name_count])
    }
    if column == COLUMN_PID {
        if left.pid < right.pid { return -1 }
        if left.pid > right.pid { return 1 }
        return 0
    }
    if column == COLUMN_CPU {
        if left.cpu_percent < right.cpu_percent { return -1 }
        if left.cpu_percent > right.cpu_percent { return 1 }
        return 0
    }
    if column == COLUMN_CPU_TIME {
        if left.ticks < right.ticks { return -1 }
        if left.ticks > right.ticks { return 1 }
        return 0
    }
    if column == COLUMN_MEMORY {
        if left.memory_bytes < right.memory_bytes { return -1 }
        if left.memory_bytes > right.memory_bytes { return 1 }
        return 0
    }
    return 0
}

CompareRows :: (snapshot: *Snapshot, left: s32, right: s32, column: s32) -> s32 {
    if left == right { return 0 }
    if left < 0 || right < 0 || left >= snapshot.count || right >= snapshot.count { return 0 }
    return CompareProcesses(*snapshot.processes[left], *snapshot.processes[right], column)
}

// Fills ORDER with a stable sort of the snapshot rows for COLUMN. Direction 1
// sorts ascending, -1 descending, and 0 leaves the natural /proc order.
#program_export
SortOrder :: (snapshot: *Snapshot, order: []s32, column: s32, direction: s32) {
    count := snapshot.count
    if count > cast(s32)order.count { count = cast(s32)order.count }
    if count > 0 {
        for index: 0..count - 1 { order[index] = index }
    }
    if column < 0 || column >= COLUMNS || direction == 0 || count < 2 { return }
    for slot: 1..count - 1 {
        key := order[slot]
        position := slot - 1
        while position >= 0 {
            comparison := CompareRows(snapshot, order[position], key, column)
            if direction < 0 { comparison = -comparison }
            if comparison <= 0 { break }
            order[position + 1] = order[position]
            position -= 1
        }
        order[position + 1] = key
    }
}

// Stable ordering for compact aggregate groups.
#program_export
SortGroupOrder :: (source: *Snapshot, grouped: *GroupedSnapshot, order: []s32,
    column: s32, direction: s32) {
    count := grouped.count
    if count > cast(s32)order.count { count = cast(s32)order.count }
    if count > 0 {
        for index: 0..count - 1 { order[index] = index }
    }
    if column < 0 || column >= COLUMNS || direction == 0 || count < 2 { return }
    for slot: 1..count - 1 {
        key := order[slot]
        key_process := GroupProcess(source, *grouped.groups[key])
        position := slot - 1
        while position >= 0 {
            other := GroupProcess(source, *grouped.groups[order[position]])
            comparison := CompareProcesses(*other, *key_process, column)
            if direction < 0 { comparison = -comparison }
            if comparison <= 0 { break }
            order[position + 1] = order[position]
            position -= 1
        }
        order[position + 1] = key
    }
}

#program_export
FormatBytes :: (value: u64, output: []u8) -> string {
    units: [5]string = .{" B", " KB", " MB", " GB", " TB"}
    scaled := cast(float64)value
    index: s32 = 0
    while scaled >= 1024.0 && index < 4 {
        scaled /= 1024.0
        index += 1
    }
    places: s32 = 1
    if index == 0 { places = 0 }
    number: [32]u8
    number_text := Number.FormatDecimal(scaled, places, number[:])
    length: s32 = 0
    pieces: [2]string = .{number_text, units[index]}
    for piece: pieces {
        for byte: piece {
            if length >= cast(s32)output.count { break }
            output[length] = byte
            length += 1
        }
    }
    return TextView(output[0:length])
}

// Appends PIECE to OUTPUT at LENGTH and returns the new length.
Append :: (output: []u8, length: s32, piece: string) -> s32 {
    at := length
    for byte: piece {
        if at >= cast(s32)output.count { break }
        output[at] = byte
        at += 1
    }
    return at
}

// A kilobyte count with thousands separators, as "1,234,567". Negative values,
// which mean the kernel did not report the figure, read as "n/a".
#program_export
FormatThousands :: (value: s64, output: []u8) -> string {
    if value < 0 { return "n/a" }
    digits: [32]u8
    text := Number.FormatInteger(value, digits[:])
    length: s32 = 0
    count := cast(s32)text.count
    for index: 0..count - 1 {
        if index > 0 && (count - index) % 3 == 0 && length < cast(s32)output.count {
            output[length] = 44
            length += 1
        }
        if length < cast(s32)output.count {
            output[length] = text[index]
            length += 1
        }
    }
    return TextView(output[0:length])
}

// Resident memory in the Mem Usage column style: "12,345 K".
#program_export
FormatKilobytes :: (bytes: u64, output: []u8) -> string {
    number: [32]u8
    text := FormatThousands(cast(s64)(bytes / 1024), number[:])
    length := Append(output, 0, text)
    length = Append(output, length, " K")
    return TextView(output[0:length])
}

// Converts a /proc meminfo value to an adaptive, explicit unit. Missing
// figures stay "n/a" instead of looking like a real zero-byte measurement.
#program_export
FormatKilobytesBytes :: (kilobytes: s64, output: []u8) -> string {
    if kilobytes < 0 { return "n/a" }
    return FormatBytes(cast(u64)kilobytes * cast(u64)1024, output)
}

// CPU time from clock ticks as H:MM:SS.
#program_export
FormatCpuTime :: (ticks: u64, output: []u8) -> string {
    EnsureTiming()
    seconds := cast(s64)(cast(float64)ticks / clock_ticks)
    hours := seconds / 3600
    minutes := (seconds / 60) % 60
    rest := seconds % 60
    digits: [24]u8
    length := Append(output, 0, Number.FormatInteger(hours, digits[:]))
    length = Append(output, length, ":")
    if minutes < 10 { length = Append(output, length, "0") }
    length = Append(output, length, Number.FormatInteger(minutes, digits[:]))
    length = Append(output, length, ":")
    if rest < 10 { length = Append(output, length, "0") }
    length = Append(output, length, Number.FormatInteger(rest, digits[:]))
    return TextView(output[0:length])
}

// A CPU share as a whole percentage with at least two digits, as "07".
#program_export
FormatCpu :: (percent: float64, output: []u8) -> string {
    value := cast(s64)(percent + 0.5)
    if value < 0 { value = 0 }
    if value > 100 { value = 100 }
    digits: [8]u8
    length: s32 = 0
    if value < 10 { length = Append(output, length, "0") }
    length = Append(output, length, Number.FormatInteger(value, digits[:]))
    return TextView(output[0:length])
}

// Starts COMMAND through /bin/sh in the background, detached from taskmgr's
// standard streams, as the Run dialog does. False when the command is empty,
// too long, or the shell could not be started.
#program_export
StartTask :: (command: string) -> bool {
    has_text := false
    for byte: command {
        if byte != 32 && byte != 9 { has_text = true }
        if byte == 0 { return false }
    }
    if !has_text { return false }
    line: [COMMAND_CAPACITY + 64]u8
    length := Append(line[:], 0, "(")
    length = Append(line[:], length, command)
    length = Append(line[:], length, ") </dev/null >/dev/null 2>&1 &")
    if length >= cast(s32)line.count - 1 || cast(s32)command.count > COMMAND_CAPACITY { return false }
    line[length] = 0
    return RunShell(*line[0]) == 0
}

// Sends SIGTERM; false when the kernel reports the request could not be made.
#program_export
EndTask :: (pid: s32) -> bool {
    if pid <= 0 { return false }
    return SendSignal(pid, STOP_SIGNAL) == 0
}

// Sends SIGTERM to every current raw process represented by GROUP. The
// caller gets exact counts so the interface can report partial failure.
#program_export
EndProcessGroup :: (source: *Snapshot, group: *Process) -> GroupEndResult {
    result: GroupEndResult
    if group.name_count <= 0 || source.count <= 0 { return result }
    for index: 0..source.count - 1 {
        entry := *source.processes[index]
        if SameProcessGroup(group, entry) {
            result.requested += 1
            if EndTask(entry.pid) { result.sent += 1 } else { result.failed += 1 }
        }
    }
    return result
}
